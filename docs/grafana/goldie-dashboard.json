{
  "title": "goldie",
  "uid": "goldie-overview",
  "tags": [
    "goldie"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "ui_url",
        "label": "goldie UI URL",
        "type": "textbox",
        "query": "http://localhost:8080",
        "current": {
          "text": "http://localhost:8080",
          "value": "http://localhost:8080"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Item uses by kind",
      "description": "Lookups and gets that found the Item (goldie.item.uses), by kind.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (rate(goldie_item_uses_total[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "links": [
            {
              "title": "Open Activity in the goldie UI",
              "url": "${ui_url}/ops/activity",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Item uses by surface",
      "description": "Uses by the surface that asked: mcp, cli or other (the UI and any other client count as other).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (via) (rate(goldie_item_uses_total[$__rate_interval]))",
          "legendFormat": "{{via}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "links": [
            {
              "title": "Open Activity in the goldie UI",
              "url": "${ui_url}/ops/activity",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Top Items used",
      "description": "Most used Items in the selected time range.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (kind, name) (increase(goldie_item_uses_total[$__range])))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Browse Assets in the goldie UI",
              "url": "${ui_url}/assets",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Uses"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Item uses by Project",
      "description": "Uses by registered Project in the selected time range; unregistered clients are one bucket.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (project) (increase(goldie_item_uses_total[$__range])))",
          "legendFormat": "{{project}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Item uses by principal",
      "description": "Uses by API token name in the selected time range; anonymous is one bucket.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (principal) (increase(goldie_item_uses_total[$__range])))",
          "legendFormat": "{{principal}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Searches and lookups by result",
      "description": "Searches and article lookups answered; a miss found nothing.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (rate(goldie_searches_total[$__rate_interval]))",
          "legendFormat": "search {{result}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (rate(goldie_lookups_total[$__rate_interval]))",
          "legendFormat": "lookup {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Items served",
      "description": "Items in the current Snapshot, by kind.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (goldie_items)",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Browse Assets in the goldie UI",
              "url": "${ui_url}/assets",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Skill gets by skill",
      "description": "Skill gets that found the skill, by skill name.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (name) (rate(goldie_skill_gets_total[$__rate_interval]))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Source polls by result",
      "description": "Finished polls of each configured Source, by result.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (source, result) (rate(goldie_syncs_total[$__rate_interval]))",
          "legendFormat": "{{source}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "links": [
            {
              "title": "Open Sources in the goldie UI",
              "url": "${ui_url}/ops/sources",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Source poll duration (p95)",
      "description": "95th percentile time a Source poll took.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(goldie_sync_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
            {
              "title": "Open Sources in the goldie UI",
              "url": "${ui_url}/ops/sources",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "MCP tool calls by tool",
      "description": "MCP tool calls answered by the server, by tool and result.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tool, result) (rate(goldie_mcp_tool_calls_total[$__rate_interval]))",
          "legendFormat": "{{tool}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    }
  ]
}
