{
  "permissions": {
    "allow": [
      "Bash(./run *)",
      "Bash(scripts/agent-gate *)",
      "Bash(scripts/loop-poll *)",
      "Bash(git *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(gh run *)",
      "Bash(gh search *)",
      "Bash(gh label list *)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(jq *)",
      "Bash(pgrep *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(diff *)",
      "Bash(mktemp *)",
      "Bash(curl -s https://api.securityscorecards.dev/*)"
    ],
    "deny": [
      "Bash(gh pr merge * --admin*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/loop-guard"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "proxy.golang.org",
        "sum.golang.org",
        "vuln.go.dev",
        "api.securityscorecards.dev"
      ]
    }
  }
}
