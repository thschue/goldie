#!/bin/sh
# loop-poll: the cheap first step of every loop tick (docs/agents/README.md).
#
#   scripts/loop-poll <deliver|product>
#
# Prints one line:
#   deliver: main=<state> red=<workflows> streams=<n>/2 renovate=<n> frontier=<n> work=<n> fingerprint=<hash>
#   product: main=<state> red=<workflows> triage=<n> decisions=<n> buffer=<n> wip=<n> fingerprint=<hash>
# main is the `ci` workflow on the head of main (green, red, pending, unknown;
# red stops the line); red lists other failed workflows there. For deliver,
# streams counts this session's open PRs ($GOLDIE_SESSION, default: the short
# host name) without a final review marker for their head, renovate the
# unreviewed Renovate PRs, and work what the tick can act on (0 ends it).
# For product, decisions counts PRs waiting on a PM decision, buffer the
# claimable issues, and wip the issues in progress. Read-only.
set -eu

die() { printf 'loop-poll: %s\n' "$*" >&2; exit 2; }
[ $# -eq 1 ] || die "usage: scripts/loop-poll <deliver|product>"
loop=$1
lib="$(cd "$(dirname "$0")" && pwd)/lib"
session=${GOLDIE_SESSION:-$(hostname -s)}

me=$(gh api user --jq .login) || die "cannot resolve the gh user"
main_sha=$(gh api 'repos/{owner}/{repo}/commits/main' --jq .sha) || die "cannot read main"
runs=$(gh run list --branch main --limit 30 --json workflowName,headSha,status,conclusion \
	--jq "[.[] | select(.headSha == \"$main_sha\")] | group_by(.workflowName) | map(.[0])") ||
	die "cannot list workflow runs"
main=$(printf '%s' "$runs" | jq -r '
	(map(select(.workflowName == "ci")) | .[0]) as $ci
	| if $ci == null then "unknown" elif $ci.status != "completed" then "pending"
	  elif $ci.conclusion == "success" then "green" else "red" end')
red=$(printf '%s' "$runs" | jq -r '
	[.[] | select(.workflowName != "ci" and .status == "completed"
		and (.conclusion == "failure" or .conclusion == "timed_out")) | .workflowName]
	| if length == 0 then "-" else join(",") end')

prs=$(gh pr list --state open --limit 200 --json number,headRefOid,headRefName,labels,author,comments) ||
	die "cannot list PRs"
frontier=$(gh issue list --state open --label ready-for-agent --limit 500 \
	--search 'no:assignee -label:in-progress -label:epic -is:blocked' --json number --jq length) ||
	die "cannot list the frontier"
# pr_count <jq filter on one PR with $m = its own markers>: how many open PRs match.
pr_count() {
	printf '%s' "$prs" | jq -L "$lib" --arg me "$me" --arg session "$session" \
		"include \"markers\"; [.[] | own_markers(\$me) as \$m | select($1)] | length"
}
case "$loop" in
deliver)
	streams=$(pr_count '.author.login == $me
		and ($m | latest("claim") | .line // "" | attr("session")) == $session
		and ([.labels[].name] | index("needs-info") | not)
		and (($m | latest("review") | .line // "" | attr("sha")) != .headRefOid)')
	renovate=$(pr_count '(.author.login | test("renovate"))
		and (($m | latest("review") | .line // "" | attr("sha")) != .headRefOid)')
	claimable=0
	[ "$streams" -ge 2 ] || claimable=$frontier
	work=$((streams + renovate + claimable))
	extra="streams=$streams/2 renovate=$renovate frontier=$frontier work=$work"
	;;
product)
	triage=$(gh issue list --state open --label needs-triage --limit 500 --json number --jq length) ||
		die "cannot count needs-triage issues"
	decisions=$(pr_count '([.labels[].name] | index("needs-info"))
		and (($m | latest("review") | .line // "" | attr("reason")) == "decision")')
	wip=$(gh issue list --state open --label in-progress --limit 500 --json number --jq length) ||
		die "cannot count issues in progress"
	extra="triage=$triage decisions=$decisions buffer=$frontier wip=$wip"
	;;
*) die "unknown loop: $loop" ;;
esac

fingerprint=$(
	{
		printf '%s\n' "$main_sha"
		gh issue list --state open --limit 500 --json number,updatedAt --jq '.[] | "\(.number) \(.updatedAt)"'
		printf '%s' "$prs" | jq -r '.[] | "\(.number) \(.headRefOid) \([.labels[].name] | sort | join(","))"'
	} | git hash-object --stdin
) || die "cannot compute the fingerprint"

printf 'main=%s red=%s %s fingerprint=%s\n' "$main" "$red" "$extra" "$fingerprint"
