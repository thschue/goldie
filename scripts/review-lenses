#!/bin/sh
# review-lenses: the reviewers a change needs (docs/agents/delivery-loop.md).
#
#   scripts/review-lenses <base> <head>   from the diff <base>...<head>
#   scripts/review-lenses -               from paths on stdin (an issue's cited
#                                         paths, for model routing)
#
# Prints one reviewer per line: always `reviewer`, then
#   - `architect` when the change adds a Go package, touches the contract or
#     go.mod, or adds an import of another goldie module;
#   - `ux-designer` when it touches the UI or the design handoff;
#   - `security-reviewer` when it touches a risk path (auth, tokens, sessions,
#     MCP, git Sources, Secrets, archives, configuration, agent guardrails).
# A `security-reviewer` line also means: run the implementer and test-author
# on opus. Exits 2 on a usage or git error. Read-only.
set -euf
LC_ALL=C
export LC_ALL

die() { printf 'review-lenses: %s\n' "$*" >&2; exit 2; }

tmp=$(mktemp -d) || die "cannot create a temporary directory"
trap 'rm -rf "$tmp"' EXIT INT TERM
: >"$tmp/lenses"
lens() { printf '%s\n' "$1" >>"$tmp/lenses"; }

if [ $# -eq 1 ] && [ "$1" = - ]; then
	cat >"$tmp/files"
	mb=
elif [ $# -eq 2 ]; then
	mb=$(git merge-base "$1" "$2") || die "no merge base between $1 and $2"
	head=$2
	git diff --name-only --no-renames "$mb" "$head" >"$tmp/files" || die "git diff failed"
else
	die "usage: scripts/review-lenses <base> <head> | scripts/review-lenses -"
fi

while IFS= read -r f; do
	case "$f" in
	internal/contract/* | go.mod) lens architect ;;
	esac
	case "$f" in
	web/* | internal/ui/* | docs/design/*) lens ux-designer ;;
	esac
	name=${f##*/}
	case "$name" in
	*auth* | *token* | *session* | *oauth* | *secret* | *credential* | *login* | *csrf* | \
		*pull* | *archive* | *bundle* | *extract*) lens security-reviewer ;;
	esac
	case "$f" in
	internal/mcp/* | internal/engine/source* | internal/engine/sync* | *git*source* | \
		internal/platform/config* | .claude/* | */.claude/* | CLAUDE.md | */CLAUDE.md | AGENTS.md | \
		docs/agents/* | scripts/* | .github/* | .mcp.json | examples/knowledge/* | SECURITY.md)
		lens security-reviewer ;;
	esac
done <"$tmp/files"

if [ -n "$mb" ]; then
	# A new Go package: a Go file added in a directory that had none.
	git diff --name-only --no-renames --diff-filter=A "$mb" "$head" -- '*.go' |
		while IFS= read -r f; do
			d=$(dirname "$f")
			if ! git ls-tree --name-only "$mb" -- "$d/" 2>/dev/null | grep -q '\.go$'; then
				printf 'architect\n'
			fi
		done >>"$tmp/lenses"
	# An added import of another goldie module (cmd, or internal/<module>).
	mod=$(GOTOOLCHAIN=local go mod edit -json 2>/dev/null | sed -n 's/.*"Path": "\([^"]*\)".*/\1/p' | head -n 1)
	if [ -n "$mod" ]; then
		git diff -U0 --no-renames "$mb" "$head" -- '*.go' | awk -v mod="$mod" '
			/^\+\+\+ b\// { f = substr($0, 7); split(f, p, "/"); own = (p[1] == "internal") ? p[2] : p[1]; next }
			/^\+/ && index($0, "\"" mod "/") {
				s = substr($0, index($0, "\"" mod "/") + length(mod) + 2); split(s, q, "[/\"]")
				dep = q[1]; if (dep == "internal") { split(substr(s, 10), r, "[/\"]"); dep = r[1] }
				if (dep != own) { print "architect"; exit }
			}' >>"$tmp/lenses"
	fi
fi

printf 'reviewer\n'
for l in architect ux-designer security-reviewer; do
	if grep -qx "$l" "$tmp/lenses"; then printf '%s\n' "$l"; fi
done
