#!/bin/sh
# agent-gate: decide whether a change needs the maintainer (ADR 0012).
#
#   scripts/agent-gate <base> <head>
#
# Prints one line per reason and exits 1 when there is any hard reason
# ("gate: …": the maintainer decides), 0 when there is none, and 2 on a
# usage, git or tool error (a caller treats 2 as a hard reason). Review
# reasons ("review: …") don't change the exit code: the reviewer judges
# whether the change is significant (docs/agents/label-contract.md#gates).
# <base> and <head> are git revisions; the diff is <base>...<head>, without
# rename detection. Run it from the repository root.
#
# Human gates are kept for security and product direction only:
#   - by path: agent guardrails and instruction files (anywhere in the tree),
#     the knowledge served to agents, the decision record, CI and release,
#     architecture enforcement, the loop tooling (`scripts/`), git
#     attributes, workspaces and vendoring, deployment;
#   - review only: a change to `run`, the task runner CI calls, which a
#     reviewer can tell apart (a new task) from a weakened check, and lines
#     only added to NOTICE (removing or rewording one is a hard reason);
#   - a new direct Go dependency, a go.mod replace, exclude, retract,
#     godebug, tool or ignore change, a Go or toolchain downgrade;
#   - a new web dependency, or a new pinned tool (`<module>@<version>`);
#   - a breaking change to the API contract (ADR 0011), through
#     `./run contract-compat`. $GATE_RUN names the `run` to use: callers pass
#     main's copy, so a change can't loosen the check that judges it.
# Version bumps of existing modules, new indirect requirements (CI enforces
# `go mod tidy`) and go.sum churn are not gated.
set -euf
LC_ALL=C
export LC_ALL

die() { printf 'agent-gate: %s\n' "$*" >&2; exit 2; }

[ $# -eq 2 ] || die "usage: scripts/agent-gate <base> <head>"
base=$1
head=$2
git rev-parse --verify --quiet "$base^{commit}" >/dev/null || die "unknown revision: $base"
git rev-parse --verify --quiet "$head^{commit}" >/dev/null || die "unknown revision: $head"
mb=$(git merge-base "$base" "$head") || die "no merge base between $base and $head"

tmp=$(mktemp -d) || die "cannot create a temporary directory"
trap 'rm -rf "$tmp"' EXIT INT TERM
reasons="$tmp/reasons"
reviews="$tmp/reviews"
: >"$reasons"
: >"$reviews"
gate() { printf 'gate: %s\n' "$*" >>"$reasons"; }
review() { printf 'review: %s\n' "$*" >>"$reviews"; }

# exists <rev> <path>; show <rev> <path>: the file at that revision. A file
# that is absent reads as empty; any other git failure stops the gate.
exists() { git cat-file -e "$1:$2" 2>/dev/null; }
show() {
	exists "$1" "$2" || return 0
	git show "$1:$2" || die "cannot read $2 at $1"
}
changed() { grep -qx -- "$1" "$tmp/files"; }
new_lines() { # new_lines <old file> <new file>: lines of <new> not in <old>
	sort -u "$1" >"$1.s"
	sort -u "$2" | comm -13 "$1.s" -
}

# --- 1. Gated paths -----------------------------------------------------------
git diff --name-only --no-renames "$mb" "$head" >"$tmp/files" || die "git diff failed"
while IFS= read -r f; do
	case "$f" in
	\"*)
		gate "unusual file name (quoted by git): $f" ;;
	docs/agents/* | .claude/* | */.claude/* | CLAUDE.md | */CLAUDE.md | AGENTS.md | */AGENTS.md | \
		SECURITY.md | .mcp.json | */.mcp.json | .claude.json | examples/knowledge/*)
		gate "agent guardrail changed: $f" ;;
	CONTEXT.md | docs/adr/* | docs/design/* | LICENSE)
		gate "decision record changed: $f" ;;
	NOTICE)
		# Adding an attribution is mechanical; removing or rewording one is
		# a licensing decision.
		removed=$(git diff --numstat --no-renames "$mb" "$head" -- NOTICE | cut -f2) ||
			die "git diff failed"
		if [ "$removed" = 0 ]; then review "attribution added: $f"; else gate "decision record changed: $f"; fi ;;
	.github/* | release-please-config.json | .goreleaser.*)
		gate "CI or release configuration changed: $f" ;;
	.golangci.* | testdata/depguard/*)
		gate "architecture enforcement changed: $f" ;;
	run)
		review "check tooling changed: $f" ;;
	scripts/* | testdata/agent-gate/* | testdata/loop-guard/*)
		gate "loop tooling changed: $f" ;;
	.gitattributes | */.gitattributes | go.work | go.work.sum | vendor/*)
		gate "build or diff configuration changed: $f" ;;
	package.json | */package.json)
		if [ "$f" != web/package.json ]; then gate "new package manifest: $f"; fi ;;
	deploy/* | Dockerfile | */Dockerfile)
		gate "deployment changed: $f" ;;
	esac
done <"$tmp/files"

# --- 2. go.mod -------------------------------------------------------------------
modjson() { # modjson <file>: `go mod edit -json`, or {} for an empty file
	# GOTOOLCHAIN=local: reading a go.mod must never download a toolchain.
	if [ -s "$1" ]; then GOTOOLCHAIN=local go mod edit -json "$1" || die "cannot parse go.mod"; else echo '{}'; fi
}
if changed go.mod; then
	command -v go >/dev/null 2>&1 || die "go is required to read go.mod"
	command -v jq >/dev/null 2>&1 || die "jq is required to read go.mod"
	show "$mb" go.mod >"$tmp/old.mod"
	show "$head" go.mod >"$tmp/new.mod"
	modjson "$tmp/old.mod" >"$tmp/old.json"
	modjson "$tmp/new.mod" >"$tmp/new.json"
	direct='(.Require // []) | map(select(.Indirect | not)) | .[].Path'
	jq -r "$direct" "$tmp/old.json" >"$tmp/old.req" || die "jq failed on go.mod"
	jq -r "$direct" "$tmp/new.json" >"$tmp/new.req" || die "jq failed on go.mod"
	for m in $(new_lines "$tmp/old.req" "$tmp/new.req"); do gate "new direct Go dependency: $m"; done
	for k in Replace Exclude Retract GoDebug Tool Ignore; do
		o=$(jq -cS ".$k // []" "$tmp/old.json")
		n=$(jq -cS ".$k // []" "$tmp/new.json")
		if [ "$o" != "$n" ]; then gate "go.mod directive changed: $k"; fi
	done
	# A downgrade (or removal) of the go or toolchain line can bring back fixed
	# bugs; an upgrade is an ordinary version bump.
	for k in Go Toolchain; do
		o=$(jq -r ".$k // empty" "$tmp/old.json" | sed 's/^go//')
		n=$(jq -r ".$k // empty" "$tmp/new.json" | sed 's/^go//')
		if [ -z "$o" ] || [ "$o" = "$n" ]; then continue; fi
		lowest=$(printf '%s\n%s\n' "$o" "${n:-0}" | sort -t. -k1,1n -k2,2n -k3,3n | head -1)
		if [ "$lowest" != "$o" ]; then gate "go.mod downgrade: $k $o to ${n:-none}"; fi
	done
fi

# --- 3. New web dependencies ---------------------------------------------------
if changed web/package.json; then
	command -v jq >/dev/null 2>&1 || die "jq is required to read web/package.json"
	deps='[(.dependencies // {}), (.devDependencies // {}), (.optionalDependencies // {}), (.peerDependencies // {})] | add // {} | keys[]'
	show "$mb" web/package.json | jq -r "$deps" >"$tmp/old.web" 2>/dev/null || : >"$tmp/old.web"
	show "$head" web/package.json | jq -r "$deps" >"$tmp/new.web" ||
		die "web/package.json at $head is not valid JSON"
	for m in $(new_lines "$tmp/old.web" "$tmp/new.web"); do gate "new web dependency: $m"; done
fi

# --- 4. New pinned tools -------------------------------------------------------
# A tool is pinned as "<module path>@<version>" in `run` or a script and
# installed with `go install`. A new module path is a new dependency.
pins() { # pins <rev>: tool module paths pinned in `run` and scripts/ at <rev>
	{
		show "$1" run
		git ls-tree -r --name-only "$1" -- scripts | while IFS= read -r s; do show "$1" "$s"; done
	} | grep -oE '[a-z0-9.-]+\.[a-z]{2,}/[A-Za-z0-9._~/-]+@' | sed 's/@$//' | sort -u
}
if grep -qE '^(run|scripts/.*)$' "$tmp/files"; then
	pins "$mb" >"$tmp/old.pins"
	pins "$head" >"$tmp/new.pins"
	for m in $(new_lines "$tmp/old.pins" "$tmp/new.pins"); do gate "new pinned tool: $m"; done
fi

# --- 5. Breaking API contract changes ------------------------------------------
spec=internal/contract/openapi.yaml
if changed "$spec" && exists "$mb" "$spec"; then
	if ! exists "$head" "$spec"; then
		gate "API contract removed: $spec"
	else
		show "$mb" "$spec" >"$tmp/old.yaml"
		show "$head" "$spec" >"$tmp/new.yaml"
		status=0
		"${GATE_RUN:-$(git rev-parse --show-toplevel)/run}" contract-compat \
			"$tmp/old.yaml" "$tmp/new.yaml" >/dev/null 2>&1 || status=$?
		case "$status" in
		0) ;;
		1) gate "breaking API contract change (ADR 0011, see ./run contract-compat)" ;;
		*) gate "API contract compatibility could not be checked (exit $status)" ;;
		esac
	fi
fi

# Print one line per reason with up to three details, so a large change still
# reads as a short list: "gate: <reason>: a, b, c and 49 more".
summarise() {
	sort -u "$1" | awk '
		{ i = index($0, ": "); rest = substr($0, i + 2); j = 0
		  for (k = length(rest); k > 0; k--) if (substr(rest, k, 2) == ": ") { j = k; break }
		  if (j == 0) { key = $0; detail = "" } else { key = substr($0, 1, i + 1) substr(rest, 1, j - 1); detail = substr(rest, j + 2) }
		  if (!(key in n)) order[++keys] = key
		  n[key]++; if (n[key] <= 3 && detail != "") list[key] = list[key] (n[key] > 1 ? ", " : "") detail }
		END { for (o = 1; o <= keys; o++) { key = order[o]
		        line = key (list[key] != "" ? ": " list[key] : "")
		        if (n[key] > 3) line = line " and " (n[key] - 3) " more"
		        print line } }'
}
[ ! -s "$reasons" ] || summarise "$reasons"
[ ! -s "$reviews" ] || summarise "$reviews"
[ ! -s "$reasons" ] || exit 1
exit 0
