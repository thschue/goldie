#!/bin/sh
# goldie task runner. POSIX sh, no dependencies beyond the Go toolchain.
#
#   ./run check      everything CI runs (the four check-* groups below)
#   ./run check-lint     format, go mod tidy, build, golangci-lint, depguard fixture
#   ./run check-spec     spec lint, regen drift check, and their fixtures
#   ./run check-harness  the loop tooling fixtures (gate-, guard-, test-lock-, lenses-,
#                        claim-, merge-pr-fixture), agent definitions, the harness line budget
#   ./run check-test     go test -race
#   ./run test       go test ./... (extra arguments are passed to go test)
#   ./run lint       golangci-lint on the module
#   ./run lint-spec  vacuum on internal/contract/openapi.yaml (zero findings)
#   ./run contract-compat <old> <new>  fail on a breaking change between two specs
#   ./run gate <base> <head>  reasons a change needs the maintainer (ADR 0012)
#   ./run red-check [base]  the PR's new tests must fail on <base> (origin/main)
#   ./run size [base]  changed lines without tests and generated code (about 400; over 600 fails)
#   ./run vuln       govulncheck on the module
#   ./run sync-agents  copy example agent Items to .claude/agents
#   ./run regen      regenerate generated code (OpenAPI Go types, strict server, endpoint and configuration reference docs)
#   ./run regen-check  fail if generated code differs from a fresh generation
#   ./run regen-fixture  prove the drift check fires on testdata/openapi/drifted.yaml
#   ./run versions   print the toolchain versions this repository expects
#
# `./run check` must exit 0 with no output from the linters ("zero warnings").
set -eu

# Pinned tools, as <package>@<version>. A new tool is a new dependency and
# needs the maintainer (scripts/agent-gate); bumping a version does not.
# Renovate bumps them through the "# renovate:" comments (renovate.json).
# renovate: datasource=go depName=github.com/golangci/golangci-lint/v2
GOLANGCI_LINT=github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0
# OpenAPI linter (MIT).
# renovate: datasource=go depName=github.com/daveshanley/vacuum
VACUUM=github.com/daveshanley/vacuum@v0.42.3
# OpenAPI breaking-change detector (Apache-2.0), for ADR 0011.
# renovate: datasource=go depName=github.com/oasdiff/oasdiff
OASDIFF=github.com/oasdiff/oasdiff@v1.38.0
# Go vulnerability scanner (BSD-3-Clause), from the Go team.
# renovate: datasource=go depName=golang.org/x/vuln
GOVULNCHECK=golang.org/x/vuln/cmd/govulncheck@v1.9.0
# OpenAPI Go code generator (Apache-2.0). Its generated code imports
# github.com/oapi-codegen/runtime, which is in go.mod.
# renovate: datasource=go depName=github.com/oapi-codegen/oapi-codegen/v2
OAPI_CODEGEN=github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.9.0

cd "$(dirname "$0")"
ROOT=$(pwd)

say() { printf '==> %s\n' "$*"; }
die() { printf 'run: %s\n' "$*" >&2; exit 1; }

# tool <package>@<version>: print the path of the pinned tool's binary,
# installing it first. Each version gets its own directory under .tools/
# (or $GOLDIE_TOOLS), so a bump never runs a stale binary. The tools' module
# downloads go to .tools/mod rather than the shared module cache, so one CI
# cache of .tools holds the binaries and every module they are built from;
# after a bump only the changed modules are downloaded. -modcacherw keeps
# that directory removable with rm -rf.
tool() {
	pkg=${1%@*}
	ver=${1##*@}
	tools="${GOLDIE_TOOLS:-$ROOT/.tools}"
	dir="$tools/${pkg##*/}-$ver"
	if [ ! -x "$dir/${pkg##*/}" ]; then
		GOBIN="$dir" GOMODCACHE="$tools/mod" GOFLAGS="${GOFLAGS:+$GOFLAGS }-modcacherw" \
			go install "$1" >&2 || die "cannot install $1"
	fi
	printf '%s\n' "$dir/${pkg##*/}"
}

golangci() {
	bin=$(tool "$GOLANGCI_LINT")
	"$bin" "$@"
}

cmd_fmt() {
	say "gofmt"
	unformatted=$(gofmt -l cmd internal testdata 2>&1) || die "gofmt failed: $unformatted"
	if [ -n "$unformatted" ]; then
		printf '%s\n' "$unformatted" >&2
		die "files above are not gofmt-formatted (run: gofmt -w <file>)"
	fi
}

# go.mod and go.sum must be tidy. This also keeps the "// indirect" markers
# honest, which scripts/agent-gate relies on to tell new direct dependencies.
cmd_tidy() {
	say "go mod tidy (no diff)"
	go mod tidy -diff || die "go.mod or go.sum is not tidy (run: go mod tidy)"
}

cmd_build() {
	say "go build"
	go build ./...
}

cmd_lint() {
	say "golangci-lint"
	golangci run --config "$ROOT/.golangci.yml" ./...
}

# The fixture is a nested module full of deliberate import-rule violations.
# The linter must report every one of them as a depguard issue, and nothing else.
cmd_lint_fixture() {
	say "depguard fixture (violations must be reported)"
	violations=$(grep -rl 'Deliberate violation' testdata/depguard | wc -l | tr -d ' ')
	out=$(cd testdata/depguard && golangci run --config "$ROOT/.golangci.yml" --output.text.colors=false ./... 2>&1) && {
		printf '%s\n' "$out" >&2
		die "depguard fixture passed lint: the import rules do not fire"
	}
	reported=$(printf '%s\n' "$out" | grep -c '(depguard)' || true)
	others=$(printf '%s\n' "$out" | grep -E '\.go:[0-9]+' | grep -vc '(depguard)' || true)
	if [ "$reported" != "$violations" ] || [ "$others" != 0 ]; then
		printf '%s\n' "$out" >&2
		die "fixture expects $violations depguard issues and no others; got $reported depguard, $others other"
	fi
}

# vacuum lints the OpenAPI document. --fail-severity info makes any finding
# (error, warning or info) fail the run, so "zero warnings" holds for the spec.
# An explicit empty --config keeps a ./vacuum.conf.yaml or a user config from
# changing the rules the gate applies, and vacuum runs without any VACUUM_*
# environment variable, which it would otherwise read as flag values.
# --remote=false keeps the check offline: the spec is one self-contained file,
# so no $ref is fetched.
vacuum() {
	cfgdir=$(mktemp -d) || die "cannot create a temporary directory for vacuum"
	: >"$cfgdir/vacuum.conf.yaml"
	bin=$(tool "$VACUUM")
	status=0
	(
		for v in $(env | sed -n 's/^\(VACUUM_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
		exec "$bin" lint --config "$cfgdir/vacuum.conf.yaml" --remote=false \
			--no-update-check --no-banner --no-style --details --fail-severity info "$@"
	) || status=$?
	rm -rf "$cfgdir"
	return "$status"
}

cmd_lint_spec() {
	say "vacuum (OpenAPI spec)"
	vacuum internal/contract/openapi.yaml
}

# The broken fixture must be rejected with lint findings (exit 1 and the
# missing-operationId rule), or the spec linter is not doing its job. Any other
# failure, such as a download or input error, fails this gate too.
cmd_lint_spec_fixture() {
	say "vacuum fixture (broken spec must be rejected)"
	status=0
	out=$(vacuum testdata/openapi/broken.yaml 2>&1) || status=$?
	if [ "$status" = 0 ]; then
		die "broken OpenAPI fixture passed lint: the spec linter does not fire"
	fi
	if [ "$status" != 1 ] || ! printf '%s\n' "$out" | grep -q 'operation-operationId'; then
		printf '%s\n' "$out" >&2
		die "broken OpenAPI fixture failed for the wrong reason (exit $status, expected lint findings)"
	fi
}

# contract-compat <old spec> <new spec>: exit 1 with oasdiff's findings when
# the new spec breaks the old one (ADR 0011: the contract is additive-only).
# scripts/agent-gate calls it to send a breaking change to the maintainer.
cmd_contract_compat() {
	[ $# -eq 2 ] || die "usage: ./run contract-compat <old spec> <new spec>"
	bin=$(tool "$OASDIFF")
	"$bin" breaking "$1" "$2" --fail-on ERR
}

# The breaking fixture removes an endpoint: contract-compat must report it,
# and must accept the spec against itself.
cmd_contract_compat_fixture() {
	say "contract-compat fixture (a removed endpoint must be reported)"
	cmd_contract_compat internal/contract/openapi.yaml internal/contract/openapi.yaml >/dev/null ||
		die "contract-compat rejects the spec against itself"
	status=0
	out=$(cmd_contract_compat internal/contract/openapi.yaml testdata/openapi/breaking.yaml 2>&1) || status=$?
	if [ "$status" != 1 ] || ! printf '%s\n' "$out" | grep -q 'api-path-removed'; then
		printf '%s\n' "$out" >&2
		die "contract-compat did not report the removed endpoint (exit $status)"
	fi
}

cmd_gate() {
	scripts/agent-gate "$@"
}

# fixture_repo <case dir> <tree>...: commit each tree of the case, in order,
# into a throwaway repository, and print its path. The first tree is commit
# "base" on main; each later tree goes on branch "work", replaces the whole work tree and is
# committed with the tree's name as its subject. The repository ignores the
# user's git config (signing, hooks, templates), so a case runs the same
# everywhere.
fixture_repo() {
	case=$1
	shift
	repo=$(mktemp -d) || die "cannot create a temporary directory"
	(
		GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
		export GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
		cd "$repo"
		git init -q -b main
		first=true
		for tree in "$@"; do
			$first || git rm -rq .
			cp -R "$ROOT/$case/$tree/." .
			msg=$tree
			$first && msg=base
			git add -A && git -c user.name=fixture -c user.email=fixture@invalid commit -qm "$msg"
			$first && git checkout -q -b work
			first=false
		done
	) >&2 || { rm -rf "$repo"; die "cannot build the $(basename "$case") case"; }
	printf '%s\n' "$repo"
}

# expect <name> <expected file> <exit status> <output>: the output must equal
# the expected file, with exit 1 when it is non-empty and 0 otherwise.
expect() {
	want=$(cat "$2")
	wstatus=0
	[ -z "$want" ] || wstatus=1
	if [ "$4" != "$want" ] || [ "$3" != "$wstatus" ]; then
		printf 'want (exit %s):\n%s\ngot (exit %s):\n%s\n' "$wstatus" "$want" "$3" "$4" >&2
		die "case $1 failed"
	fi
}

# Each case in testdata/agent-gate/ has a base/ and a head/ tree and the
# expected output. The gate must print exactly the expected reasons, with
# exit 1 when any of them is a hard ("gate:") reason.
cmd_gate_fixture() {
	say "agent-gate fixture (each case gives its expected reasons)"
	for case in testdata/agent-gate/*/; do
		repo=$(fixture_repo "$case" base head)
		status=0
		out=$(cd "$repo" && GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
			"$ROOT/scripts/agent-gate" HEAD~1 HEAD 2>&1) || status=$?
		rm -rf "$repo"
		want=$(cat "${case}expected")
		wstatus=0
		if grep -q '^gate: ' "${case}expected"; then wstatus=1; fi
		if [ "$out" != "$want" ] || [ "$status" != "$wstatus" ]; then
			printf 'want (exit %s):\n%s\ngot (exit %s):\n%s\n' "$wstatus" "$want" "$status" "$out" >&2
			die "agent-gate case $(basename "$case") failed"
		fi
	done
}

# Each case in testdata/test-lock/ holds numbered trees (1-base, 2-author,
# 3-impl, ...) committed in order; trees named *-author are passed as
# test-author commits. The lock must print exactly the expected violations.
cmd_test_lock_fixture() {
	say "test-lock fixture (implementers can't change locked test lines)"
	for case in testdata/test-lock/*/; do
		trees=$(cd "$case" && ls -d [0-9]*-* | sort -n)
		repo=$(fixture_repo "$case" $trees)
		status=0
		out=$(cd "$repo" && authors=$(git log --format='%H %s' main..HEAD | awk '$2 ~ /-author$/ {print $1}') &&
			GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
			"$ROOT/scripts/test-lock" main HEAD $authors 2>&1) || status=$?
		rm -rf "$repo"
		expect "test-lock $(basename "$case")" "${case}expected" "$status" "$out"
	done
}

# Each case in testdata/review-lenses/ has a base/ and a head/ tree; the
# script must name exactly the expected reviewers.
cmd_lenses_fixture() {
	say "review-lenses fixture (each diff gets its expected reviewers)"
	for case in testdata/review-lenses/*/; do
		repo=$(fixture_repo "$case" base head)
		out=$(cd "$repo" && "$ROOT/scripts/review-lenses" HEAD~1 HEAD 2>&1) ||
			{ rm -rf "$repo"; die "review-lenses failed on $(basename "$case"): $out"; }
		rm -rf "$repo"
		[ "$out" = "$(cat "${case}expected")" ] ||
			die "review-lenses case $(basename "$case"): want [$(cat "${case}expected" | tr '\n' ' ')], got [$(printf '%s' "$out" | tr '\n' ' ')]"
	done
}

# Two delivery sessions claim the same issue at once against a local origin,
# with a fake gh (testdata/claim/bin): exactly one must win, and a later claim
# and an unclaimable issue must be refused with exit 3.
cmd_claim_fixture() {
	say "claim fixture (the first branch push wins)"
	work=$(mktemp -d) || die "cannot create a temporary directory"
	(
		GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
		export GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
		export PATH="$ROOT/testdata/claim/bin:$PATH" FAKE_GH_DIR="$work"
		cd "$work"
		git init -q --bare -b main origin.git
		git init -q -b main seed && cd seed && echo x >x &&
			git add x && git -c user.name=f -c user.email=f@invalid commit -qm base &&
			git remote add origin ../origin.git && git push -q origin main && cd ..
		git clone -q origin.git a && git clone -q origin.git b
		cp "$ROOT/testdata/claim/ready.json" issue.json
		claim() { (cd "$1" && GOLDIE_SESSION=$1 GIT_AUTHOR_NAME=f GIT_AUTHOR_EMAIL=f@invalid \
			GIT_COMMITTER_NAME=f GIT_COMMITTER_EMAIL=f@invalid "$ROOT/scripts/claim" 42 feat >/dev/null 2>&1); }
		sa=0; sb=0
		claim a & pa=$!
		claim b & pb=$!
		wait "$pa" || sa=$?
		wait "$pb" || sb=$?
		[ "$sa$sb" = 03 ] || [ "$sa$sb" = 30 ] || die "two concurrent claims: want one 0 and one 3, got $sa and $sb"
		[ "$(git --git-dir=origin.git for-each-ref --format=%\(refname\) refs/heads/feat/)" = \
			refs/heads/feat/issue-42-project-aware-search-mcp ] || die "claim pushed an unexpected branch: $(git --git-dir=origin.git for-each-ref --format="%(refname)" refs/heads/)"
		s=0; claim a || s=$?
		[ "$s" = 3 ] || die "a claim of an already claimed issue: want exit 3, got $s"
		cp "$ROOT/testdata/claim/in-progress.json" issue.json
		s=0; claim b || s=$?
		[ "$s" = 3 ] || die "a claim of an in-progress issue: want exit 3, got $s"
	) || { rm -rf "$work"; exit 1; }
	rm -rf "$work"
}

# merge-pr against a local origin and a fake gh (testdata/merge-pr/bin): a
# clean marker for the head queues the PR; a missing or stale marker, a test
# lock violation and a gated path are refused with their exit codes.
cmd_merge_fixture() {
	say "merge-pr fixture (only a clean, ungated, unlocked head is queued)"
	work=$(mktemp -d) || die "cannot create a temporary directory"
	(
		GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_AUTHOR_NAME=f GIT_AUTHOR_EMAIL=f@invalid
		GIT_COMMITTER_NAME=f GIT_COMMITTER_EMAIL=f@invalid
		export GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
		export PATH="$ROOT/testdata/merge-pr/bin:$PATH" FAKE_GH_DIR="$work"
		cd "$work"
		git init -q --bare -b main origin.git
		git clone -q origin.git c 2>/dev/null && cd c
		mkdir -p scripts/lib && cp "$ROOT/run" . && cp "$ROOT/scripts/agent-gate" "$ROOT/scripts/test-lock" "$ROOT/scripts/merge-pr" scripts/ &&
			cp "$ROOT/scripts/lib/markers.jq" scripts/lib/ && printf 'x\n' >a_test.go && git add -A && git commit -qm base &&
			git push -q origin main
		commit() { printf '%s\n' "$2" >>"$1" && git add -A && git commit -qm "$3" && git rev-parse HEAD; }
		git checkout -q -b feat/issue-1-x
		t=$(commit a_test.go 'acceptance' 'test(acceptance): x')
		h1=$(commit a.go 'code' 'feat: x')
		git push -q origin HEAD
		marker() { printf '<!-- goldie-loop:%s -->' "$1"; }
		pr() { # pr <head> <final marker lines...>
			head=$1; shift
			for m in "$@"; do printf '%s\n' "$m"; done |
				jq -Rn --arg h "$head" '{state: "OPEN", baseRefName: "main", headRefOid: $h, headRefName: "feat/issue-1-x",
					isDraft: true, author: {login: "loop"}, comments: [inputs | {author: {login: "loop"}, createdAt: "t", body: .}]}' >../pr.json
		}
		run_merge() { s=0; scripts/merge-pr 7 "$1" >/dev/null 2>&1 || s=$?; [ "$s" = "$2" ] || die "merge-pr $3: want exit $2, got $s"; }
		pr "$h1" "$(marker "tests sha=$t")"
		run_merge "$h1" 2 "without a review marker"
		pr "$h1" "$(marker "tests sha=$t")" "$(marker "review sha=$t reason=clean rounds=0")"
		run_merge "$h1" 2 "with a marker for another sha"
		pr "$h1" "$(marker "tests sha=$t")" "$(marker "review sha=$h1 reason=clean rounds=0")"
		run_merge "$h1" 0 "with a clean marker"
		grep -qx "pr merge 7 --auto --squash --match-head-commit $h1" ../gh.log || die "merge-pr did not enable auto-merge"
		git checkout -q feat/issue-1-x && sed -i.bak 's/acceptance/weakened/' a_test.go && rm a_test.go.bak && git commit -qam "feat: y"
		h2=$(git rev-parse HEAD) && git push -q origin HEAD
		pr "$h2" "$(marker "tests sha=$t")" "$(marker "review sha=$h2 reason=clean rounds=1")"
		run_merge "$h2" 3 "with a weakened acceptance test"
		h3=$(commit CLAUDE.md 'rules' 'docs: z') && git push -q origin HEAD
		pr "$h3" "$(marker "tests sha=$t")" "$(marker "review sha=$h3 reason=clean rounds=0")"
		run_merge "$h3" 1 "on a gated path"
	) || { rm -rf "$work"; exit 1; }
	rm -rf "$work"
}

# The loop rules stay short (ADR 0018): docs/agents within 600 lines in total,
# each loop script within 200.
cmd_harness_budget() {
	say "harness budget (docs/agents <= 600 lines, each script <= 200)"
	total=$(cat docs/agents/*.md | wc -l | tr -d ' ')
	[ "$total" -le 600 ] || die "docs/agents/*.md has $total lines; the budget is 600 (ADR 0018)"
	for f in scripts/*; do
		[ -f "$f" ] || continue
		n=$(wc -l <"$f" | tr -d ' ')
		[ "$n" -le 200 ] || die "$f has $n lines; the budget is 200 (ADR 0018)"
	done
}

# size [base]: changed lines against the merge base with <base> (default
# origin/main), not counting tests, testdata, generated code and go.sum.
# About 400 is the budget; over 600 fails, and the PR is sliced.
cmd_size() {
	base=${1:-origin/main}
	mb=$(git merge-base "$base" HEAD) || die "no merge base with $base"
	n=$(git diff --numstat --no-renames "$mb" -- . ':(exclude)*_test.go' ':(exclude)testdata' \
		':(exclude)**/testdata/**' ':(exclude)go.sum' ":(exclude)$CONTRACT_GEN" \
		":(exclude)$CONTRACT_DOCS" ":(exclude)$CONFIG_DOCS" | awk '$1 != "-" { s += $1 + $2 } END { print s + 0 }')
	say "size: $n changed lines (budget about 400)"
	[ "$n" -le 600 ] || die "size: $n changed lines is over 600; slice the change"
}

# Every line of testdata/loop-guard/cases.tsv is "allow" or "deny", a tab and
# a command; the hook must block exactly the "deny" lines.
cmd_guard_fixture() {
	say "loop-guard fixture (the hook blocks exactly the denied commands)"
	command -v jq >/dev/null 2>&1 || die "jq is required for the loop-guard fixture"
	tab=$(printf '\t')
	grep -v '^#' testdata/loop-guard/cases.tsv | while IFS="$tab" read -r want cmd; do
		status=0
		jq -n --arg c "$cmd" '{tool_name: "Bash", tool_input: {command: $c}}' |
			scripts/loop-guard 2>/dev/null || status=$?
		got=allow
		[ "$status" = 2 ] && got=deny
		[ "$got" = "$want" ] || die "loop-guard: want $want, got $got (exit $status): $cmd"
	done
}

# .claude/agents/ holds byte copies of the example agent Items, so the agents
# the loops dispatch are the Items goldie serves (one source of truth).
cmd_sync_agents() {
	mkdir -p .claude/agents
	rm -f .claude/agents/*.md
	cp examples/knowledge/global/agents/*.md .claude/agents/
}

cmd_agents_check() {
	say "agent definitions match their Items"
	out=$(diff -r examples/knowledge/global/agents .claude/agents 2>&1) || {
		printf '%s\n' "$out" >&2
		die ".claude/agents differs from examples/knowledge/global/agents (run: ./run sync-agents)"
	}
}

# red-check [base]: copy the test files the branch changed onto <base> (default
# origin/main) and require the tests to fail there, as proof that they were
# red first. A reviewer tool, not part of check: a test that pins existing
# behaviour passes on <base> by design, and the reviewer judges that case.
cmd_red_check() {
	base=${1:-origin/main}
	mb=$(git merge-base "$base" HEAD) || die "no merge base with $base"
	tests=$(git diff --name-only --no-renames --diff-filter=AM "$mb" HEAD -- '*_test.go')
	if [ -z "$tests" ]; then
		say "red-check: the branch changes no test files"
		return 0
	fi
	wt=$(mktemp -d) || die "cannot create a temporary directory"
	git worktree add -q --detach "$wt" "$mb" || die "cannot create a worktree at $mb"
	for t in $tests; do
		mkdir -p "$wt/$(dirname "$t")"
		git show "HEAD:$t" >"$wt/$t"
	done
	pkgs=$(printf '%s\n' "$tests" | sed 's#/[^/]*$##' | sort -u | sed 's#^#./#')
	status=0
	(cd "$wt" && go test -count=1 $pkgs) >/dev/null 2>&1 || status=$?
	git worktree remove --force "$wt"
	if [ "$status" = 0 ]; then
		die "red-check: the changed tests pass on $base; they don't prove the change"
	fi
	say "red-check: the changed tests fail on $base"
}

cmd_vuln() {
	say "govulncheck"
	bin=$(tool "$GOVULNCHECK")
	"$bin" ./...
}

cmd_test() {
	say "go test"
	go test -count=1 "$@" ./...
}

# Generated files, relative to the repository root.
CONTRACT_SPEC=internal/contract/openapi.yaml
CONTRACT_DOCS=docs/reference/api.md
CONFIG_DOCS=docs/reference/configuration.md
CONTRACT_CONFIG=internal/contract/oapi-codegen.yaml
CONTRACT_GEN=internal/contract/contract.gen.go

# oapi_codegen <spec> <output>: generate Go types and the strict server from
# <spec> into <output>. Generation is written to a temporary file first, so a
# failed run never leaves a truncated generated file behind. It returns
# non-zero on failure, so the caller can clean up before it dies.
oapi_codegen() {
	tmp=$(mktemp) || die "cannot create a temporary file for oapi-codegen"
	bin=$(tool "$OAPI_CODEGEN")
	if "$bin" -config "$CONTRACT_CONFIG" "$1" >"$tmp" && cat "$tmp" >"$2"; then
		rm -f "$tmp"
	else
		rm -f "$tmp"
		return 1
	fi
}

cmd_regen() {
	say "regen: oapi-codegen ${OAPI_CODEGEN##*@}"
	oapi_codegen "$CONTRACT_SPEC" "$CONTRACT_GEN" || die "oapi-codegen failed for $CONTRACT_SPEC"
	say "regen: endpoint reference docs"
	mkdir -p "$(dirname "$CONTRACT_DOCS")"
	go run ./internal/contract/cmd/refdocs "$CONTRACT_SPEC" "$CONTRACT_DOCS" || die "cannot generate $CONTRACT_DOCS"
	say "regen: configuration reference docs"
	go run ./internal/platform/cmd/configdocs "$CONFIG_DOCS" || die "cannot generate $CONFIG_DOCS"
	# TypeScript types register here as their issue lands.
}

# drift <spec>: succeed when the committed generated code equals a fresh
# generation from <spec>, return 1 when they differ, and die when they cannot
# be compared, so the fixture never passes for the wrong reason.
drift() {
	fresh=$(mktemp) || die "cannot create a temporary file for the drift check"
	if ! oapi_codegen "$1" "$fresh"; then
		rm -f "$fresh"
		die "oapi-codegen failed for $1"
	fi
	status=0
	cmp -s "$fresh" "$CONTRACT_GEN" || status=$?
	rm -f "$fresh"
	[ "$status" -le 1 ] || die "cannot compare $CONTRACT_GEN with a fresh generation (cmp exit $status)"
	return "$status"
}

# docs_drift <committed> <generator...>: succeed when <committed> equals the
# output of the generator, which is run with a temporary output path appended.
# Returns 1 when they differ and dies when they cannot be compared.
docs_drift() {
	committed=$1
	shift
	fresh=$(mktemp) || die "cannot create a temporary file for the docs drift check"
	if ! "$@" "$fresh"; then
		rm -f "$fresh"
		die "generator failed: $*"
	fi
	status=0
	cmp -s "$fresh" "$committed" || status=$?
	rm -f "$fresh"
	[ "$status" -le 1 ] || die "cannot compare $committed with a fresh generation (cmp exit $status)"
	return "$status"
}

# Endpoint reference docs from <spec>; configuration docs from the registry.
refdocs_drift() { docs_drift "$CONTRACT_DOCS" go run ./internal/contract/cmd/refdocs "$1"; }
configdocs_drift() { docs_drift "${1:-$CONFIG_DOCS}" go run ./internal/platform/cmd/configdocs; }

cmd_regen_check() {
	say "regen drift check (generated code and docs must match the spec)"
	drift "$CONTRACT_SPEC" || die "$CONTRACT_GEN is out of date with $CONTRACT_SPEC (run: ./run regen)"
	refdocs_drift "$CONTRACT_SPEC" || die "$CONTRACT_DOCS is out of date with $CONTRACT_SPEC (run: ./run regen)"
	configdocs_drift || die "$CONFIG_DOCS is out of date with the settings registry (run: ./run regen)"
}

# The drifted fixture is a spec the committed generated code was not made from:
# the drift check must flag it, or it cannot catch a stale generated file.
cmd_regen_fixture() {
	say "regen drift fixture (a drifted spec must be flagged)"
	if drift testdata/openapi/drifted.yaml; then
		die "drift check did not fire for testdata/openapi/drifted.yaml"
	fi
	if refdocs_drift testdata/openapi/drifted.yaml; then
		die "docs drift check did not fire for testdata/openapi/drifted.yaml"
	fi
	if configdocs_drift testdata/config/drifted.md; then
		die "config docs drift check did not fire for testdata/config/drifted.md"
	fi
}


cmd_versions() {
	printf 'go (module requires): %s\n' "$(awk '$1 == "go" {print $2}' go.mod)"
	printf 'go (installed):       %s\n' "$(go version)"
	for t in "$GOLANGCI_LINT" "$VACUUM" "$OASDIFF" "$GOVULNCHECK" "$OAPI_CODEGEN"; do
		printf 'pinned: %s\n' "$t"
	done
}

# CI runs the four groups as parallel jobs; `check` runs them in sequence.
# `run` is a gated path: any change to it needs the maintainer.
cmd_check_lint() {
	cmd_fmt
	cmd_tidy
	cmd_build
	cmd_lint
	cmd_lint_fixture
}

cmd_check_spec() {
	cmd_lint_spec
	cmd_lint_spec_fixture
	cmd_contract_compat_fixture
	cmd_regen_check
	cmd_regen_fixture
}

cmd_check_harness() {
	cmd_gate_fixture
	cmd_guard_fixture
	cmd_test_lock_fixture
	cmd_lenses_fixture
	cmd_claim_fixture
	cmd_merge_fixture
	cmd_agents_check
	cmd_harness_budget
}

cmd_check_test() {
	cmd_test -race
}

cmd_check() {
	cmd_check_lint
	cmd_check_spec
	cmd_check_harness
	cmd_check_test
	say "check passed"
}

usage() {
	awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

[ $# -ge 1 ] || { usage; exit 2; }
sub=$1
shift
case "$sub" in
check) cmd_check ;;
check-lint) cmd_check_lint ;;
check-spec) cmd_check_spec ;;
check-harness) cmd_check_harness ;;
test-lock-fixture) cmd_test_lock_fixture ;;
lenses-fixture) cmd_lenses_fixture ;;
claim-fixture) cmd_claim_fixture ;;
merge-pr-fixture) cmd_merge_fixture ;;
gate-fixture) cmd_gate_fixture ;;
guard-fixture) cmd_guard_fixture ;;
check-test) cmd_check_test ;;
test) cmd_test "$@" ;;
lint) cmd_lint ;;
lint-spec) cmd_lint_spec ;;
lint-spec-fixture) cmd_lint_spec_fixture ;;
contract-compat) cmd_contract_compat "$@" ;;
gate) cmd_gate "$@" ;;
red-check) cmd_red_check "$@" ;;
size) cmd_size "$@" ;;
vuln) cmd_vuln ;;
sync-agents) cmd_sync_agents ;;
regen) cmd_regen ;;
regen-check) cmd_regen_check ;;
regen-fixture) cmd_regen_fixture ;;
versions) cmd_versions ;;
help | -h | --help) usage ;;
*) usage >&2; exit 2 ;;
esac
