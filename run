#!/bin/sh
# goldie task runner. POSIX sh, no dependencies beyond the Go toolchain.
#
#   ./run check      everything CI runs: format, build, lint, lint fixtures, spec lint, tests
#   ./run test       go test ./... (extra arguments are passed to go test)
#   ./run lint       golangci-lint on the module
#   ./run lint-spec  vacuum on internal/contract/openapi.yaml (zero findings)
#   ./run lint-spec-fixture  prove vacuum rejects testdata/openapi/broken.yaml
#   ./run regen      regenerate generated code (OpenAPI Go types and strict server)
#   ./run regen-check  fail if generated code differs from a fresh generation
#   ./run regen-fixture  prove the drift check fires on testdata/openapi/drifted.yaml
#   ./run versions   print the toolchain versions this repository expects
#
# `./run check` must exit 0 with no output from the linters ("zero warnings").
set -eu

GOLANGCI_LINT_VERSION=v2.15.0
# OpenAPI linter (MIT), run through `go run` like golangci-lint.
VACUUM_VERSION=v0.42.3
# OpenAPI Go code generator (Apache-2.0), run through `go run`. Its generated
# code imports github.com/oapi-codegen/runtime, which is in go.mod.
OAPI_CODEGEN_VERSION=v2.9.0

cd "$(dirname "$0")"
ROOT=$(pwd)

say() { printf '==> %s\n' "$*"; }
die() { printf 'run: %s\n' "$*" >&2; exit 1; }

# golangci-lint: use the pinned version from PATH when present, else run it
# through the Go module proxy (cached after the first call).
golangci() {
	if command -v golangci-lint >/dev/null 2>&1 &&
		golangci-lint version 2>&1 | grep -q "version ${GOLANGCI_LINT_VERSION#v}"; then
		golangci-lint "$@"
	else
		go run "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}" "$@"
	fi
}

cmd_fmt() {
	say "gofmt"
	unformatted=$(gofmt -l cmd internal testdata 2>&1) || die "gofmt failed: $unformatted"
	if [ -n "$unformatted" ]; then
		printf '%s\n' "$unformatted" >&2
		die "files above are not gofmt-formatted (run: gofmt -w <file>)"
	fi
}

cmd_build() {
	say "go build"
	go build ./...
}

cmd_lint() {
	say "golangci-lint"
	golangci run --config "$ROOT/.golangci.yml" ./...
}

# The fixture is a nested module full of deliberate import-rule violations.
# The linter must report every one of them as a depguard issue, and nothing else.
cmd_lint_fixture() {
	say "depguard fixture (violations must be reported)"
	violations=$(grep -rl 'Deliberate violation' testdata/depguard | wc -l | tr -d ' ')
	out=$(cd testdata/depguard && golangci run --config "$ROOT/.golangci.yml" --output.text.colors=false ./... 2>&1) && {
		printf '%s\n' "$out" >&2
		die "depguard fixture passed lint: the import rules do not fire"
	}
	reported=$(printf '%s\n' "$out" | grep -c '(depguard)' || true)
	others=$(printf '%s\n' "$out" | grep -E '\.go:[0-9]+' | grep -vc '(depguard)' || true)
	if [ "$reported" != "$violations" ] || [ "$others" != 0 ]; then
		printf '%s\n' "$out" >&2
		die "fixture expects $violations depguard issues and no others; got $reported depguard, $others other"
	fi
}

# vacuum lints the OpenAPI document. --fail-severity info makes any finding
# (error, warning or info) fail the run, so "zero warnings" holds for the spec.
# An explicit empty --config keeps a ./vacuum.conf.yaml or a user config from
# changing the rules the gate applies, and vacuum runs without any VACUUM_*
# environment variable, which it would otherwise read as flag values.
# --remote=false keeps the check offline: the spec is one self-contained file,
# so no $ref is fetched.
vacuum() {
	cfgdir=$(mktemp -d) || die "cannot create a temporary directory for vacuum"
	: >"$cfgdir/vacuum.conf.yaml"
	pkg="github.com/daveshanley/vacuum@${VACUUM_VERSION}"
	status=0
	(
		for v in $(env | sed -n 's/^\(VACUUM_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
		exec go run "$pkg" lint --config "$cfgdir/vacuum.conf.yaml" --remote=false \
			--no-update-check --no-banner --no-style --details --fail-severity info "$@"
	) || status=$?
	rm -rf "$cfgdir"
	return "$status"
}

cmd_lint_spec() {
	say "vacuum (OpenAPI spec)"
	vacuum internal/contract/openapi.yaml
}

# The broken fixture must be rejected with lint findings (exit 1 and the
# missing-operationId rule), or the spec linter is not doing its job. Any other
# failure, such as a download or input error, fails this gate too.
cmd_lint_spec_fixture() {
	say "vacuum fixture (broken spec must be rejected)"
	status=0
	out=$(vacuum testdata/openapi/broken.yaml 2>&1) || status=$?
	if [ "$status" = 0 ]; then
		die "broken OpenAPI fixture passed lint: the spec linter does not fire"
	fi
	if [ "$status" != 1 ] || ! printf '%s\n' "$out" | grep -q 'operation-operationId'; then
		printf '%s\n' "$out" >&2
		die "broken OpenAPI fixture failed for the wrong reason (exit $status, expected lint findings)"
	fi
}

cmd_test() {
	say "go test"
	go test -count=1 "$@" ./...
}

# Generated files, relative to the repository root.
CONTRACT_SPEC=internal/contract/openapi.yaml
CONTRACT_CONFIG=internal/contract/oapi-codegen.yaml
CONTRACT_GEN=internal/contract/contract.gen.go

# oapi_codegen <spec> <output>: generate Go types and the strict server from
# <spec> into <output>. Generation is written to a temporary file first, so a
# failed run never leaves a truncated generated file behind.
oapi_codegen() {
	tmp=$(mktemp) || die "cannot create a temporary file for oapi-codegen"
	if go run "github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@${OAPI_CODEGEN_VERSION}" \
		-config "$CONTRACT_CONFIG" "$1" >"$tmp" && cat "$tmp" >"$2"; then
		rm -f "$tmp"
	else
		rm -f "$tmp"
		die "oapi-codegen failed for $1"
	fi
}

cmd_regen() {
	say "regen: oapi-codegen $OAPI_CODEGEN_VERSION"
	oapi_codegen "$CONTRACT_SPEC" "$CONTRACT_GEN"
	# TypeScript types and component docs register here as their issues land.
}

# drift <spec>: succeed when the committed generated code equals a fresh
# generation from <spec>, return 1 when they differ, and die when they cannot
# be compared, so the fixture never passes for the wrong reason.
drift() {
	fresh=$(mktemp) || die "cannot create a temporary file for the drift check"
	status=0
	oapi_codegen "$1" "$fresh"
	cmp -s "$fresh" "$CONTRACT_GEN" || status=$?
	rm -f "$fresh"
	[ "$status" -le 1 ] || die "cannot compare $CONTRACT_GEN with a fresh generation (cmp exit $status)"
	return "$status"
}

cmd_regen_check() {
	say "regen drift check (generated code must match the spec)"
	drift "$CONTRACT_SPEC" || die "$CONTRACT_GEN is out of date with $CONTRACT_SPEC (run: ./run regen)"
}

# The drifted fixture is a spec the committed generated code was not made from:
# the drift check must flag it, or it cannot catch a stale generated file.
cmd_regen_fixture() {
	say "regen drift fixture (a drifted spec must be flagged)"
	if drift testdata/openapi/drifted.yaml; then
		die "drift check did not fire for testdata/openapi/drifted.yaml"
	fi
}

cmd_versions() {
	printf 'go (module requires): %s\n' "$(awk '$1 == "go" {print $2}' go.mod)"
	printf 'go (installed):       %s\n' "$(go version)"
	printf 'golangci-lint (pinned): %s\n' "$GOLANGCI_LINT_VERSION"
	printf 'vacuum (pinned):        %s\n' "$VACUUM_VERSION"
	printf 'oapi-codegen (pinned):  %s\n' "$OAPI_CODEGEN_VERSION"
}

cmd_check() {
	cmd_fmt
	cmd_build
	cmd_lint
	cmd_lint_fixture
	cmd_lint_spec
	cmd_lint_spec_fixture
	cmd_regen_check
	cmd_regen_fixture
	cmd_test
	say "check passed"
}

usage() {
	sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

[ $# -ge 1 ] || { usage; exit 2; }
sub=$1
shift
case "$sub" in
check) cmd_check ;;
test) cmd_test "$@" ;;
lint) cmd_lint ;;
lint-spec) cmd_lint_spec ;;
lint-spec-fixture) cmd_lint_spec_fixture ;;
regen) cmd_regen ;;
regen-check) cmd_regen_check ;;
regen-fixture) cmd_regen_fixture ;;
versions) cmd_versions ;;
help | -h | --help) usage ;;
*) usage >&2; exit 2 ;;
esac
