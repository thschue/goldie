#!/bin/sh
# goldie task runner. POSIX sh, no dependencies beyond the Go toolchain.
#
#   ./run check      everything CI runs (the four check-* groups below)
#   ./run check-lint     format, go mod tidy, build, golangci-lint, depguard fixture
#   ./run check-spec     spec lint, regen drift check, and their fixtures
#   ./run check-harness  the loop tooling fixtures (gate-, guard-, test-lock-, frontier-,
#                        stream-state-, claim-fixture), agent definitions, the line budget
#   ./run check-test     go test -race
#   ./run test       go test ./... (extra arguments are passed to go test)
#   ./run lint       golangci-lint on the module
#   ./run lint-spec  vacuum on internal/contract/openapi.yaml (zero findings)
#   ./run contract-compat <old> <new>  fail on a breaking change between two specs
#   ./run gate <base> <head>  reasons a change needs the maintainer (ADR 0012)
#   ./run red-check [base]  the PR's new tests must fail on <base> (origin/main)
#   ./run size [base]  changed lines without tests and generated code (about 400; over 600 fails)
#   ./run vuln       govulncheck on the module
#   ./run sync-agents  copy example agent Items to .claude/agents
#   ./run regen      regenerate generated code (OpenAPI Go types, strict server, endpoint and configuration reference docs)
#   ./run ui         build the SPA (npm ci --ignore-scripts, npm run build in web/) into internal/ui/dist/app;
#                    needs Node, not part of check
#   ./run ux         build, type-check and run the component tests, serve examples/knowledge and run the
#                    Playwright specs in web/e2e
#                    (screenshots, axe) into ux/, the CI artifact for the UX review; needs Node
#   ./run regen-check  fail if generated code differs from a fresh generation
#   ./run regen-fixture  prove the drift check fires on testdata/openapi/drifted.yaml
#   ./run versions   print the toolchain versions this repository expects
#
# `./run check` must exit 0 with no output from the linters ("zero warnings").
set -eu

# Pinned tools, as <package>@<version>. A new tool is a new dependency and
# needs the maintainer (scripts/agent-gate); bumping a version does not.
# Renovate bumps them through the "# renovate:" comments (renovate.json).
# renovate: datasource=go depName=github.com/golangci/golangci-lint/v2
GOLANGCI_LINT=github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0
# OpenAPI linter (MIT).
# renovate: datasource=go depName=github.com/daveshanley/vacuum
VACUUM=github.com/daveshanley/vacuum@v0.42.3
# OpenAPI breaking-change detector (Apache-2.0), for ADR 0011.
# renovate: datasource=go depName=github.com/oasdiff/oasdiff
OASDIFF=github.com/oasdiff/oasdiff@v1.38.0
# Go vulnerability scanner (BSD-3-Clause), from the Go team.
# renovate: datasource=go depName=golang.org/x/vuln
GOVULNCHECK=golang.org/x/vuln/cmd/govulncheck@v1.9.0
# OpenAPI Go code generator (Apache-2.0). Its generated code imports
# github.com/oapi-codegen/runtime, which is in go.mod.
# renovate: datasource=go depName=github.com/oapi-codegen/oapi-codegen/v2
OAPI_CODEGEN=github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.9.0

cd "$(dirname "$0")"
ROOT=$(pwd)

say() { printf '==> %s\n' "$*"; }
die() { printf 'run: %s\n' "$*" >&2; exit 1; }

# Every temporary file and directory lives under one scratch directory,
# RUN_TMP, made before a task runs and removed when ./run exits, however it
# exits: normally, on a failure, or on INT or TERM (130 and 143, as cmd_ux
# did). RUN_WT is a red-check worktree to unregister, bg_pid the command
# bg is waiting for.
RUN_TMP=
RUN_WT=
bg_pid=
cleanup() {
	if [ -n "$bg_pid" ]; then
		kill "$bg_pid" 2>/dev/null || :
		wait "$bg_pid" 2>/dev/null || :
		bg_pid=
	fi
	[ -z "${ux_pid:-}" ] || ux_stop
	if [ -n "$RUN_WT" ]; then
		git worktree remove --force "$RUN_WT" >/dev/null 2>&1 || :
		RUN_WT=
	fi
	if [ -n "$RUN_TMP" ]; then
		rm -rf "$RUN_TMP"
		RUN_TMP=
	fi
}

# bg <command...>: run the command in the background and wait for it, with
# its status as the result. A shell runs a trap only after a foreground
# command ends, but wait is interrupted by a trapped signal, so INT and TERM
# end ./run, and the wrapped command, at once.
bg() {
	"$@" &
	bg_pid=$!
	bg_status=0
	wait "$bg_pid" || bg_status=$?
	bg_pid=
	return "$bg_status"
}

# tool <package>@<version>: print the path of the pinned tool's binary,
# installing it first. Each version gets its own directory under .tools/ of
# the main checkout, shared by its worktrees (or $GOLDIE_TOOLS), so a bump
# never runs a stale binary. The tools' module
# downloads go to .tools/mod rather than the shared module cache, so one CI
# cache of .tools holds the binaries and every module they are built from;
# after a bump only the changed modules are downloaded. -modcacherw keeps
# that directory removable with rm -rf. A failed install exits 2, so a caller
# can tell "could not run" from the tool's own verdict.
tool() {
	pkg=${1%@*}
	ver=${1##*@}
	common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=$ROOT/.git
	tools="${GOLDIE_TOOLS:-$(dirname "$common")/.tools}"
	dir="$tools/${pkg##*/}-$ver"
	if [ ! -x "$dir/${pkg##*/}" ]; then
		GOBIN="$dir" GOMODCACHE="$tools/mod" GOFLAGS="${GOFLAGS:+$GOFLAGS }-modcacherw" \
			go install "$1" >&2 || { printf 'run: cannot install %s\n' "$1" >&2; exit 2; }
	fi
	printf '%s\n' "$dir/${pkg##*/}"
}

golangci() {
	bin=$(tool "$GOLANGCI_LINT")
	"$bin" "$@"
}

cmd_fmt() {
	say "gofmt"
	unformatted=$(gofmt -l cmd internal testdata 2>&1) || die "gofmt failed: $unformatted"
	if [ -n "$unformatted" ]; then
		printf '%s\n' "$unformatted" >&2
		die "files above are not gofmt-formatted (run: gofmt -w <file>)"
	fi
}

# go.mod and go.sum must be tidy. This also keeps the "// indirect" markers
# honest, which scripts/agent-gate relies on to tell new direct dependencies.
cmd_tidy() {
	say "go mod tidy (no diff)"
	go mod tidy -diff || die "go.mod or go.sum is not tidy (run: go mod tidy)"
}

cmd_build() {
	say "go build"
	go build ./...
}

cmd_lint() {
	say "golangci-lint"
	golangci run --config "$ROOT/.golangci.yml" ./...
}

# The fixture is a nested module full of deliberate import-rule violations.
# The linter must report every one of them as a depguard issue, and nothing else.
cmd_lint_fixture() {
	say "depguard fixture (violations must be reported)"
	violations=$(grep -rl 'Deliberate violation' testdata/depguard | wc -l | tr -d ' ')
	out=$(cd testdata/depguard && golangci run --config "$ROOT/.golangci.yml" --output.text.colors=false ./... 2>&1) && {
		printf '%s\n' "$out" >&2
		die "depguard fixture passed lint: the import rules do not fire"
	}
	reported=$(printf '%s\n' "$out" | grep -c '(depguard)' || true)
	others=$(printf '%s\n' "$out" | grep -E '\.go:[0-9]+' | grep -vc '(depguard)' || true)
	if [ "$reported" != "$violations" ] || [ "$others" != 0 ]; then
		printf '%s\n' "$out" >&2
		die "fixture expects $violations depguard issues and no others; got $reported depguard, $others other"
	fi
}

# vacuum lints the OpenAPI document. --fail-severity info makes any finding
# (error, warning or info) fail the run, so "zero warnings" holds for the spec.
# An explicit empty --config keeps a ./vacuum.conf.yaml or a user config from
# changing the rules the gate applies, and vacuum runs without any VACUUM_*
# environment variable, which it would otherwise read as flag values.
# --ruleset applies internal/contract/vacuum-ruleset.yaml: the recommended rules
# with camel-case-properties replaced by snake-case rules (ADR 0024).
# --remote=false keeps the check offline: the spec is one self-contained file,
# so no $ref is fetched.
vacuum() {
	cfgdir=$(mktemp -d "$RUN_TMP/d.XXXXXX") || die "cannot create a temporary directory for vacuum"
	: >"$cfgdir/vacuum.conf.yaml"
	bin=$(tool "$VACUUM")
	status=0
	bg env_vacuum "$bin" "$cfgdir" "$@" || status=$?
	rm -rf "$cfgdir"
	return "$status"
}
env_vacuum() {
	bin=$1 cfgdir=$2
	shift 2
	# No inner subshell: bg already runs this function in one, and exec makes
	# the tool that process, so cleanup's kill reaches the tool itself.
	for v in $(env | sed -n 's/^\(VACUUM_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
	exec "$bin" lint --config "$cfgdir/vacuum.conf.yaml" --ruleset internal/contract/vacuum-ruleset.yaml --remote=false \
		--no-update-check --no-banner --no-style --details --fail-severity info "$@"
}

cmd_lint_spec() {
	say "vacuum (OpenAPI spec)"
	vacuum internal/contract/openapi.yaml
}

# The broken fixture must be rejected with lint findings (exit 1 and the
# missing-operationId rule), or the spec linter is not doing its job. Any other
# failure, such as a download or input error, fails this gate too.
cmd_lint_spec_fixture() {
	say "vacuum fixture (broken spec must be rejected)"
	status=0
	out=$(vacuum testdata/openapi/broken.yaml 2>&1) || status=$?
	if [ "$status" = 0 ]; then
		die "broken OpenAPI fixture passed lint: the spec linter does not fire"
	fi
	if [ "$status" != 1 ] || ! printf '%s\n' "$out" | grep -q 'operation-operationId'; then
		printf '%s\n' "$out" >&2
		die "broken OpenAPI fixture failed for the wrong reason (exit $status, expected lint findings)"
	fi
}

# The camelCase fixture must be reported by both snake-case rules.
cmd_lint_spec_casing_fixture() {
	say "vacuum fixture (camelCase names must be rejected)"
	status=0
	out=$(vacuum testdata/openapi/camelcase.yaml 2>&1) || status=$?
	for rule in snake-case-properties snake-case-query-parameters; do
		if [ "$status" != 1 ] || ! printf '%s\n' "$out" | grep -q "$rule"; then
			printf '%s\n' "$out" >&2
			die "camelCase OpenAPI fixture was not reported by $rule (exit $status)"
		fi
	done
	# The query parameter under components.parameters must be reported too.
	if ! printf '%s\n' "$out" | grep -q 'sortOrder'; then
		printf '%s\n' "$out" >&2
		die "camelCase query parameter under components.parameters was not reported (exit $status)"
	fi
}

# contract-compat <old spec> <new spec>: exit 1 with oasdiff's findings when
# the new spec breaks the old one (ADR 0011: the contract is additive-only).
# scripts/agent-gate calls it to send a breaking change to the maintainer.
cmd_contract_compat() {
	[ $# -eq 2 ] || die "usage: ./run contract-compat <old spec> <new spec>"
	bin=$(tool "$OASDIFF")
	"$bin" breaking "$1" "$2" --fail-on ERR
}

# The breaking fixture removes an endpoint: contract-compat must report it,
# and must accept the spec against itself.
cmd_contract_compat_fixture() {
	say "contract-compat fixture (a removed endpoint must be reported)"
	cmd_contract_compat internal/contract/openapi.yaml internal/contract/openapi.yaml >/dev/null ||
		die "contract-compat rejects the spec against itself"
	status=0
	out=$(cmd_contract_compat internal/contract/openapi.yaml testdata/openapi/breaking.yaml 2>&1) || status=$?
	if [ "$status" != 1 ] || ! printf '%s\n' "$out" | grep -q 'api-path-removed'; then
		printf '%s\n' "$out" >&2
		die "contract-compat did not report the removed endpoint (exit $status)"
	fi
}

cmd_gate() {
	scripts/agent-gate "$@"
}

# Each case in testdata/agent-gate/ has a base/ and a head/ tree and the
# expected output. The case is committed into a throwaway repository and the
# gate must print exactly the expected reasons, with exit 1 when any of them
# is a hard ("gate:") reason.
cmd_gate_fixture() {
	say "agent-gate fixture (each case gives its expected reasons)"
	for case in testdata/agent-gate/*/; do
		name=$(basename "$case")
		repo=$(mktemp -d "$RUN_TMP/d.XXXXXX") || die "cannot create a temporary directory"
		(
			# The throwaway repository ignores the user's git config (signing,
			# hooks, templates), so the case runs the same everywhere.
			GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
			export GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
			cd "$repo"
			git init -q -b main
			cp -R "$ROOT/${case}base/." .
			git add -A && git -c user.name=fixture -c user.email=fixture@invalid commit -qm base
			git rm -rq . && cp -R "$ROOT/${case}head/." .
			git add -A && git -c user.name=fixture -c user.email=fixture@invalid commit -qm head
		) || { rm -rf "$repo"; die "cannot build the $name case"; }
		status=0
		out=$(cd "$repo" && GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
			"$ROOT/scripts/agent-gate" HEAD~1 HEAD 2>&1) || status=$?
		rm -rf "$repo"
		want=$(cat "${case}expected")
		wstatus=0
		if grep -q '^gate: ' "${case}expected"; then wstatus=1; fi
		if [ "$out" != "$want" ] || [ "$status" != "$wstatus" ]; then
			printf 'want (exit %s):\n%s\ngot (exit %s):\n%s\n' "$wstatus" "$want" "$status" "$out" >&2
			die "agent-gate case $name failed"
		fi
	done
}

# fixture_git: git for throwaway fixture repositories, ignoring the user's git
# config (signing, hooks, templates), so a case runs the same everywhere.
fixture_git() { GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null git -c user.name=fixture -c user.email=fixture@invalid "$@"; }

# testdata/test-lock/cases.tsv: each case's rows are replayed as commits into a
# throwaway repository, and the lock must print exactly the case's "want" lines.
cmd_test_lock_fixture() {
	say "test-lock fixture (implementers can't change locked test lines)"
	tab=$(printf '\t')
	cases=testdata/test-lock/cases.tsv
	for name in $(grep -v '^#' "$cases" | cut -f1 | uniq); do
		repo=$(mktemp -d "$RUN_TMP/d.XXXXXX") || die "cannot create a temporary directory"
		fixture_git -C "$repo" init -q -b main || die "cannot create a repository for $name"
		prev=
		grep "^$name$tab" "$cases" | grep -v "^$name${tab}want$tab" >"$repo/.rows"
		while IFS="$tab" read -r _ commit path content; do
			if [ -n "$prev" ] && [ "$commit" != "$prev" ]; then
				(cd "$repo" && fixture_git add -A -- . ':!.rows' && fixture_git commit -qm "$prev") || die "cannot commit $prev"
				[ "$prev" != base ] || fixture_git -C "$repo" checkout -q -b work
			fi
			prev=$commit
			mkdir -p "$repo/$(dirname "$path")"
			if [ "$content" = - ]; then rm -f "$repo/$path"; else printf '%b\n' "$content" >"$repo/$path"; fi
		done <"$repo/.rows"
		(cd "$repo" && fixture_git add -A -- . ':!.rows' && fixture_git commit -qm "$prev") || die "cannot commit $prev"
		rm "$repo/.rows"
		status=0
		out=$(cd "$repo" && authors=$(git log --format='%H %s' main..HEAD | awk '$2 ~ /-author$/ {print $1}') &&
			GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
			"$ROOT/scripts/test-lock" main HEAD $authors 2>&1) || status=$?
		rm -rf "$repo"
		want=$(grep "^$name${tab}want$tab" "$cases" | cut -f3-)
		wstatus=0
		[ -z "$want" ] || wstatus=1
		if [ "$out" != "$want" ] || [ "$status" != "$wstatus" ]; then
			printf 'want (exit %s):\n%s\ngot (exit %s):\n%s\n' "$wstatus" "$want" "$status" "$out" >&2
			die "test-lock case $name failed"
		fi
	done
}

# testdata/frontier/cases.json: each case's issues, ranked by
# scripts/lib/frontier.jq, must come out in the case's order.
cmd_frontier_fixture() {
	say "frontier fixture (claim order: P level, then started epic, standalone, new epic)"
	out=$(jq -L scripts/lib -r 'include "frontier";
		.[] | (.issues | rank | map(.number)) as $got
		| select($got != .want) | "\(.name): want \(.want), got \($got)"' testdata/frontier/cases.json) ||
		die "cannot run the frontier cases"
	[ -z "$out" ] || die "frontier case failed: $out"
}

# testdata/stream-state/cases.json: each case's PR must get the case's state
# from stream_state in scripts/lib/markers.jq (what a delivery tick does next).
cmd_stream_state_fixture() {
	say "stream-state fixture (a stream owns its PR until it merges or closes)"
	out=$(jq -L scripts/lib -r 'include "markers";
		.[] | (.pr | stream_state("loop")) as $got
		| select($got != .want) | "\(.name): want \(.want), got \($got)"' testdata/stream-state/cases.json) ||
		die "cannot run the stream-state cases"
	[ -z "$out" ] || die "stream-state case failed: $out"
}

# Two delivery sessions claim the same issue at once against a local origin,
# with a fake gh (testdata/claim/bin): exactly one must win, with an area
# prefix ("mcp: …") turned into the PR title's scope; a later claim and an
# unclaimable issue must be refused with exit 3, and an unreachable origin
# with exit 2, never as a lost race; once the PR is closed, the issue is
# claimed again on the -r2 branch.
cmd_claim_fixture() {
	say "claim fixture (the first branch push wins)"
	work=$(mktemp -d "$RUN_TMP/d.XXXXXX") || die "cannot create a temporary directory"
	(
		GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
		export GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
		export PATH="$ROOT/testdata/claim/bin:$PATH" FAKE_GH_DIR="$work"
		cd "$work"
		git init -q --bare -b main origin.git
		git init -q -b main seed && cd seed && echo x >x &&
			git add x && git -c user.name=f -c user.email=f@invalid commit -qm base &&
			git remote add origin ../origin.git && git push -q origin main && cd ..
		git clone -q origin.git a && git clone -q origin.git b && git clone -q origin.git c &&
			git -C c remote set-url origin "$work/missing.git"
		cp "$ROOT/testdata/claim/ready.json" issue.json
		claim() { (cd "$1" && GOLDIE_SESSION=$1 GIT_AUTHOR_NAME=f GIT_AUTHOR_EMAIL=f@invalid \
			GIT_COMMITTER_NAME=f GIT_COMMITTER_EMAIL=f@invalid "$ROOT/scripts/claim" 42 feat >/dev/null 2>&1); }
		sa=0; sb=0
		claim a & pa=$!
		claim b & pb=$!
		wait "$pa" || sa=$?
		wait "$pb" || sb=$?
		[ "$sa$sb" = 03 ] || [ "$sa$sb" = 30 ] || die "two concurrent claims: want one 0 and one 3, got $sa and $sb"
		[ "$(git --git-dir=origin.git for-each-ref --format=%\(refname\) refs/heads/feat/)" = \
			refs/heads/feat/issue-42-project-aware-search ] || die "claim pushed an unexpected branch: $(git --git-dir=origin.git for-each-ref --format="%(refname)" refs/heads/)"
		grep -q -- '--title feat(mcp): project-aware search' gh.log || die "claim did not turn the area prefix into the PR title's scope"
		s=0; claim a || s=$?
		[ "$s" = 3 ] || die "a claim of an already claimed issue: want exit 3, got $s"
		s=0; claim c || s=$?
		[ "$s" = 2 ] || die "a claim against an unreachable origin: want exit 2, got $s"
		cp "$ROOT/testdata/claim/in-progress.json" issue.json
		s=0; claim b || s=$?
		[ "$s" = 3 ] || die "a claim of an in-progress issue: want exit 3, got $s"
		cp "$ROOT/testdata/claim/ready.json" issue.json && echo CLOSED >prs
		s=0; claim b || s=$?
		[ "$s" = 0 ] && git --git-dir=origin.git rev-parse -q --verify refs/heads/feat/issue-42-project-aware-search-r2 >/dev/null ||
			die "a claim after a closed PR: want exit 0 on the -r2 branch, got $s"
	) || { rm -rf "$work"; exit 1; }
	rm -rf "$work"
}

# Each loop script stays within 200 lines (ADR 0018).
cmd_harness_budget() {
	say "harness budget (each script <= 200 lines)"
	for f in scripts/*; do
		[ -f "$f" ] || continue
		n=$(wc -l <"$f" | tr -d ' ')
		[ "$n" -le 200 ] || die "$f has $n lines; the budget is 200 (ADR 0018)"
	done
}

# size [base]: changed lines against the merge base with <base> (default
# origin/main), not counting tests (Go and web/e2e), testdata, generated code,
# lockfiles, fonts and attributions.
# About 400 is the budget; over 600 fails, and the PR is sliced.
cmd_size() {
	base=${1:-origin/main}
	mb=$(git merge-base "$base" HEAD) || die "no merge base with $base"
	n=$(git diff --numstat --no-renames "$mb" -- . ':(exclude)*_test.go' ':(exclude)testdata' \
		':(exclude)**/testdata/**' ':(exclude)go.sum' ":(exclude)$CONTRACT_GEN" \
		':(exclude)web/e2e' ':(exclude)*.spec.ts' ':(exclude)*package-lock.json' ':(exclude)*.woff2' \
		':(exclude)NOTICE' ':(exclude)*VENDORED.md' \
		":(exclude)$CONTRACT_DOCS" ":(exclude)$CONFIG_DOCS" | awk '$1 != "-" { s += $1 + $2 } END { print s + 0 }')
	say "size: $n changed lines (budget about 400)"
	[ "$n" -le 600 ] || die "size: $n changed lines is over 600; slice the change"
}

# Every line of testdata/loop-guard/cases.tsv is "allow" or "deny", a tab and
# a command; the hook must block exactly the "deny" lines.
cmd_guard_fixture() {
	say "loop-guard fixture (the hook blocks exactly the denied commands)"
	command -v jq >/dev/null 2>&1 || die "jq is required for the loop-guard fixture"
	tab=$(printf '\t')
	grep -v '^#' testdata/loop-guard/cases.tsv | while IFS="$tab" read -r want cmd; do
		status=0
		jq -n --arg c "$cmd" '{tool_name: "Bash", tool_input: {command: $c}}' |
			scripts/loop-guard 2>/dev/null || status=$?
		got=allow
		[ "$status" = 2 ] && got=deny
		[ "$got" = "$want" ] || die "loop-guard: want $want, got $got (exit $status): $cmd"
	done
}

# .claude/agents/ holds byte copies of the example agent Items, so the agents
# the loops dispatch are the Items goldie serves (one source of truth).
cmd_sync_agents() {
	mkdir -p .claude/agents
	rm -f .claude/agents/*.md
	cp examples/knowledge/global/agents/*.md .claude/agents/
}

cmd_agents_check() {
	say "agent definitions match their Items"
	out=$(diff -r examples/knowledge/global/agents .claude/agents 2>&1) || {
		printf '%s\n' "$out" >&2
		die ".claude/agents differs from examples/knowledge/global/agents (run: ./run sync-agents)"
	}
}

# red-check [base]: copy the test files the branch changed onto <base> (default
# origin/main) and require the tests to fail there, as proof that they were
# red first. A reviewer tool, not part of check: a test that pins existing
# behaviour passes on <base> by design, and the reviewer judges that case.
red_check_test() {
	wt=$1
	shift
	# No inner subshell: bg runs this in one, and exec makes go test that
	# process, so cleanup's kill reaches it before the worktree is removed.
	cd "$wt" && exec go test -count=1 "$@"
}

cmd_red_check() {
	base=${1:-origin/main}
	mb=$(git merge-base "$base" HEAD) || die "no merge base with $base"
	tests=$(git diff --name-only --no-renames --diff-filter=AM "$mb" HEAD -- '*_test.go')
	if [ -z "$tests" ]; then
		say "red-check: the branch changes no test files"
		return 0
	fi
	wt=$(mktemp -d "$RUN_TMP/d.XXXXXX") || die "cannot create a temporary directory"
	git worktree add -q --detach "$wt" "$mb" || die "cannot create a worktree at $mb"
	RUN_WT=$wt
	for t in $tests; do
		mkdir -p "$wt/$(dirname "$t")"
		git show "HEAD:$t" >"$wt/$t"
	done
	pkgs=$(printf '%s\n' "$tests" | sed 's#/[^/]*$##' | sort -u | sed 's#^#./#')
	status=0
	bg red_check_test "$wt" $pkgs >/dev/null 2>&1 || status=$?
	git worktree remove --force "$wt"
	RUN_WT=
	if [ "$status" = 0 ]; then
		die "red-check: the changed tests pass on $base; they don't prove the change"
	fi
	say "red-check: the changed tests fail on $base"
}

cmd_vuln() {
	say "govulncheck"
	bin=$(tool "$GOVULNCHECK")
	"$bin" ./...
}

cmd_test() {
	say "go test"
	# -v is what prints a skip's message. The output goes to a file so go
	# test's exit status survives, then is shown without the per-test
	# progress lines. Skips of timing-sensitive tests ("TIMING-SKIP:" message
	# prefix) are summarised afterwards; this only reports, it never fails.
	out=$(mktemp "$RUN_TMP/f.XXXXXX") || die "test: mktemp failed"
	status=0
	bg go test -count=1 -v "$@" ./... >"$out" 2>&1 || status=$?
	# tr drops NUL bytes first, and both run under LC_ALL=C: grep would otherwise
	# treat the file as binary and swallow the failure text, and a UTF-8 locale
	# makes BSD tr stop at, and GNU grep flag, invalid UTF-8. tr is POSIX; grep -a is not.
	LC_ALL=C tr -d '\000' <"$out" | LC_ALL=C grep -Ev '^(=== (RUN|PAUSE|CONT|NAME)|[[:space:]]*--- PASS)' || true
	# go test -v streams a test's log lines between its "=== RUN" and its
	# "--- SKIP", so the test is the latest name from a RUN/NAME/CONT line.
	skipped=$(LC_ALL=C tr -d '\000' <"$out" | awk '
		/^=== (RUN|NAME|CONT)[ \t]/ { n = $3 }
		/^[ \t]+[^ \t:]+:[0-9]+: TIMING-SKIP:/ { if (n != "" && !(n in seen)) { seen[n] = 1; print n } }
	' | tr '\n' ' ')
	rm -f "$out"
	if [ -n "$skipped" ]; then
		printf 'run: timing-sensitive test(s) skipped: %s\n' "${skipped% }" >&2
	fi
	return "$status"
}

# Generated files, relative to the repository root.
CONTRACT_SPEC=internal/contract/openapi.yaml
CONTRACT_DOCS=docs/reference/api.md
CONFIG_DOCS=docs/reference/configuration.md
CONTRACT_CONFIG=internal/contract/oapi-codegen.yaml
CONTRACT_GEN=internal/contract/contract.gen.go

# oapi_codegen <spec> <output>: generate Go types and the strict server from
# <spec> into <output>. Generation is written to a temporary file first, so a
# failed run never leaves a truncated generated file behind. It returns
# non-zero on failure, so the caller can clean up before it dies.
oapi_codegen() {
	tmp=$(mktemp "$RUN_TMP/f.XXXXXX") || die "cannot create a temporary file for oapi-codegen"
	bin=$(tool "$OAPI_CODEGEN")
	if bg "$bin" -config "$CONTRACT_CONFIG" "$1" >"$tmp" && cat "$tmp" >"$2"; then
		rm -f "$tmp"
	else
		rm -f "$tmp"
		return 1
	fi
}

# cmd_ui builds the SPA into internal/ui/dist/app, which is gitignored and
# embedded by the next go build (ADR 0019). It needs Node and is not part of
# check, so Go-only contributors never run it.
cmd_ui() {
	[ -f web/package.json ] || die "web/package.json not found: the SPA source is not in this checkout"
	command -v npm >/dev/null 2>&1 || die "npm not found: ./run ui needs Node"
	# --ignore-scripts: no package runs code at install. The build runs the
	# pinned vite through npm run, never npx, which could fetch an unpinned one.
	say "ui: npm ci --ignore-scripts"
	(cd web && npm ci --ignore-scripts) || die "npm ci failed in web/"
	say "ui: npm run build"
	(cd web && npm run build) || die "the SPA build failed in web/"
}

# ux: the screenshot and axe evidence for the UX review (handoff §7, §12). It
# builds the UI and the binary, serves examples/knowledge on loopback with a
# throwaway token and free ports, and runs the Playwright specs in web/e2e
# against it. Everything lands in ux/ (screenshots, report, server log), which
# the CI job uploads as the ux artifact. A reviewer tool like red-check, not
# part of check: it needs Node and a browser. The exit trap (cleanup) always stops the server.
UX_DIR=ux
cmd_ux() {
	rm -rf "$UX_DIR"
	mkdir -p "$UX_DIR" || die "cannot create $UX_DIR/"
	cmd_ui
	say "ux: type-check and component tests"
	(cd web && npm run typecheck) || die "ux: the type check failed in web/"
	(cd web && npm test) || die "ux: the component tests in web/src failed"
	say "ux: playwright install chromium"
	# --with-deps installs the browser's system libraries, which needs root:
	# CI only. --no never downloads an unpinned playwright.
	(cd web && npx --no playwright install ${CI:+--with-deps} chromium) || die "playwright install failed"
	ux_tmp=$(mktemp -d "$RUN_TMP/d.XXXXXX") || die "cannot create a temporary directory"
	ux_pid=
	say "ux: go build"
	go build -o "$ux_tmp/goldie" ./cmd/goldie || die "go build failed"
	(umask 077 && od -An -tx1 -N32 /dev/urandom | tr -d ' \n' >"$ux_tmp/token") ||
		die "cannot create the throwaway token"
	say "ux: goldie server on examples/knowledge"
	(ux_goldie 127.0.0.1:0 server) >"$UX_DIR/server.log" 2>&1 &
	ux_pid=$!
	i=0
	while :; do
		kill -0 "$ux_pid" 2>/dev/null || ux_fail "goldie server exited during startup"
		app=$(ux_addr app)
		admin=$(ux_addr admin)
		if [ -n "$app" ] && [ -n "$admin" ] && (ux_goldie "$admin" health --ready) >/dev/null 2>&1; then
			break
		fi
		i=$((i + 1))
		[ "$i" -lt 30 ] || ux_fail "goldie server not ready after 30 seconds"
		sleep 1
	done
	say "ux: playwright test against http://$app"
	status=0
	(cd web && GOLDIE_UX_URL="http://$app" UX_DIR="$ROOT/$UX_DIR" npx --no playwright test) || status=$?
	[ "$status" = 0 ] || die "ux: the Playwright specs failed; the report is in $UX_DIR/"
	say "ux: screenshots and report in $UX_DIR/"
}

# ux_goldie <admin-addr> <args>: exec the built binary with only the
# configuration ./run ux sets, since a token or address from the caller's
# environment would clash with it. Port 0 on loopback takes a free port, which
# the server logs (ux_addr). Call it in a subshell: it changes the environment
# and execs, so the subshell's pid is goldie's.
ux_goldie() {
	for v in $(env | sed -n 's/^\(GOLDIE_[A-Z0-9_]*\)=.*/\1/p'); do unset "$v"; done
	export GOLDIE_ADMIN_ADDR="$1" GOLDIE_ADDR=127.0.0.1:0 GOLDIE_DRAIN_SECONDS=0 \
		GOLDIE_CONTENT_DIR="$ROOT/examples/knowledge" GOLDIE_API_TOKEN_FILE="$ux_tmp/token"
	shift
	exec "$ux_tmp/goldie" "$@"
}

# ux_addr <listener>: the address the server logged for the app or admin listener.
ux_addr() {
	grep '"msg":"listening"' "$UX_DIR/server.log" | grep "\"listener\":\"$1\"" |
		sed -n 's/.*"addr":"\([^"]*\)".*/\1/p' | head -n 1
}

# ux_fail prints the server log, which stays in ux/ for the artifact, and fails.
ux_fail() {
	printf 'run: ux: %s; the server log (%s/server.log):\n' "$1" "$UX_DIR" >&2
	cat "$UX_DIR/server.log" >&2
	exit 1
}

ux_stop() {
	if [ -n "$ux_pid" ]; then
		kill "$ux_pid" 2>/dev/null || :
		wait "$ux_pid" 2>/dev/null || :
	fi
	ux_pid=
}

cmd_regen() {
	say "regen: oapi-codegen ${OAPI_CODEGEN##*@}"
	oapi_codegen "$CONTRACT_SPEC" "$CONTRACT_GEN" || die "oapi-codegen failed for $CONTRACT_SPEC"
	say "regen: endpoint reference docs"
	mkdir -p "$(dirname "$CONTRACT_DOCS")"
	go run ./internal/contract/cmd/refdocs "$CONTRACT_SPEC" "$CONTRACT_DOCS" || die "cannot generate $CONTRACT_DOCS"
	say "regen: configuration reference docs"
	go run ./internal/platform/cmd/configdocs "$CONFIG_DOCS" || die "cannot generate $CONFIG_DOCS"
	# TypeScript types register here as their issue lands.
}

# drift <spec>: succeed when the committed generated code equals a fresh
# generation from <spec>, return 1 when they differ, and die when they cannot
# be compared, so the fixture never passes for the wrong reason.
drift() {
	fresh=$(mktemp "$RUN_TMP/f.XXXXXX") || die "cannot create a temporary file for the drift check"
	if ! oapi_codegen "$1" "$fresh"; then
		rm -f "$fresh"
		die "oapi-codegen failed for $1"
	fi
	status=0
	cmp -s "$fresh" "$CONTRACT_GEN" || status=$?
	rm -f "$fresh"
	[ "$status" -le 1 ] || die "cannot compare $CONTRACT_GEN with a fresh generation (cmp exit $status)"
	return "$status"
}

# docs_drift <committed> <generator...>: succeed when <committed> equals the
# output of the generator, which is run with a temporary output path appended.
# Returns 1 when they differ and dies when they cannot be compared.
docs_drift() {
	committed=$1
	shift
	fresh=$(mktemp "$RUN_TMP/f.XXXXXX") || die "cannot create a temporary file for the docs drift check"
	if ! bg "$@" "$fresh"; then
		rm -f "$fresh"
		die "generator failed: $*"
	fi
	status=0
	cmp -s "$fresh" "$committed" || status=$?
	rm -f "$fresh"
	[ "$status" -le 1 ] || die "cannot compare $committed with a fresh generation (cmp exit $status)"
	return "$status"
}

# Endpoint reference docs from <spec>; configuration docs from the registry.
refdocs_drift() { docs_drift "$CONTRACT_DOCS" go run ./internal/contract/cmd/refdocs "$1"; }
configdocs_drift() { docs_drift "${1:-$CONFIG_DOCS}" go run ./internal/platform/cmd/configdocs; }

cmd_regen_check() {
	say "regen drift check (generated code and docs must match the spec)"
	drift "$CONTRACT_SPEC" || die "$CONTRACT_GEN is out of date with $CONTRACT_SPEC (run: ./run regen)"
	refdocs_drift "$CONTRACT_SPEC" || die "$CONTRACT_DOCS is out of date with $CONTRACT_SPEC (run: ./run regen)"
	configdocs_drift || die "$CONFIG_DOCS is out of date with the settings registry (run: ./run regen)"
}

# The drifted fixture is a spec the committed generated code was not made from:
# the drift check must flag it, or it cannot catch a stale generated file.
cmd_regen_fixture() {
	say "regen drift fixture (a drifted spec must be flagged)"
	if drift testdata/openapi/drifted.yaml; then
		die "drift check did not fire for testdata/openapi/drifted.yaml"
	fi
	if refdocs_drift testdata/openapi/drifted.yaml; then
		die "docs drift check did not fire for testdata/openapi/drifted.yaml"
	fi
	if configdocs_drift testdata/config/drifted.md; then
		die "config docs drift check did not fire for testdata/config/drifted.md"
	fi
}


cmd_versions() {
	printf 'go (module requires): %s\n' "$(awk '$1 == "go" {print $2}' go.mod)"
	printf 'go (installed):       %s\n' "$(go version)"
	for t in "$GOLANGCI_LINT" "$VACUUM" "$OASDIFF" "$GOVULNCHECK" "$OAPI_CODEGEN"; do
		printf 'pinned: %s\n' "$t"
	done
}

# CI runs the four groups as parallel jobs; `check` runs them in sequence.
# `run` is a gated path: any change to it needs the maintainer.
cmd_check_lint() {
	cmd_fmt
	cmd_tidy
	cmd_build
	cmd_lint
	cmd_lint_fixture
}

cmd_check_spec() {
	cmd_lint_spec
	cmd_lint_spec_fixture
	cmd_lint_spec_casing_fixture
	cmd_contract_compat_fixture
	cmd_regen_check
	cmd_regen_fixture
}

cmd_check_harness() {
	cmd_gate_fixture
	cmd_guard_fixture
	cmd_test_lock_fixture
	cmd_frontier_fixture
	cmd_stream_state_fixture
	cmd_claim_fixture
	cmd_agents_check
	cmd_harness_budget
}

cmd_check_test() {
	cmd_test -race
}

cmd_check() {
	cmd_check_lint
	cmd_check_spec
	cmd_check_harness
	cmd_check_test
	say "check passed"
}

usage() {
	awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

[ $# -ge 1 ] || { usage; exit 2; }
sub=$1
shift
RUN_TMP=$(mktemp -d "${TMPDIR:-/tmp}/run.XXXXXX") || die "cannot create a temporary directory"
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
case "$sub" in
check) cmd_check ;;
check-lint) cmd_check_lint ;;
check-spec) cmd_check_spec ;;
check-harness) cmd_check_harness ;;
test-lock-fixture) cmd_test_lock_fixture ;;
claim-fixture) cmd_claim_fixture ;;
frontier-fixture) cmd_frontier_fixture ;;
stream-state-fixture) cmd_stream_state_fixture ;;
gate-fixture) cmd_gate_fixture ;;
guard-fixture) cmd_guard_fixture ;;
check-test) cmd_check_test ;;
test) cmd_test "$@" ;;
lint) cmd_lint ;;
lint-spec) cmd_lint_spec ;;
lint-spec-fixture) cmd_lint_spec_fixture ;;
lint-spec-casing-fixture) cmd_lint_spec_casing_fixture ;;
contract-compat) cmd_contract_compat "$@" ;;
gate) cmd_gate "$@" ;;
red-check) cmd_red_check "$@" ;;
size) cmd_size "$@" ;;
vuln) cmd_vuln ;;
sync-agents) cmd_sync_agents ;;
regen) cmd_regen ;;
ui) cmd_ui ;;
ux) cmd_ux ;;
regen-check) cmd_regen_check ;;
regen-fixture) cmd_regen_fixture ;;
versions) cmd_versions ;;
help | -h | --help) usage ;;
*) usage >&2; exit 2 ;;
esac
