#!/bin/sh
# goldie task runner. POSIX sh, no dependencies beyond the Go toolchain.
#
#   ./run check      everything CI runs (the four check-* groups below)
#   ./run check-lint     format, build, golangci-lint, depguard fixture
#   ./run check-spec     spec lint and its fixture, contract-compat fixture
#   ./run check-harness  agent-gate, loop-guard and agent-definition checks
#   ./run check-test     go test -race
#   ./run test       go test ./... (extra arguments are passed to go test)
#   ./run lint       golangci-lint on the module
#   ./run lint-spec  vacuum on internal/contract/openapi.yaml (zero findings)
#   ./run contract-compat <old> <new>  fail on a breaking change between two specs
#   ./run gate <base> <head>  reasons a change needs the maintainer (ADR 0012)
#   ./run red-check [base]  the PR's new tests must fail on <base> (origin/main)
#   ./run vuln       govulncheck on the module
#   ./run sync-agents  copy example agent Items to .claude/agents
#   ./run regen      regenerate generated code (nothing to generate yet)
#   ./run versions   print the toolchain versions this repository expects
#
# `./run check` must exit 0 with no output from the linters ("zero warnings").
set -eu

# Pinned tools, as <package>@<version>. A new tool is a new dependency and
# needs the maintainer (scripts/agent-gate); bumping a version does not.
GOLANGCI_LINT=github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0
# OpenAPI linter (MIT).
VACUUM=github.com/daveshanley/vacuum@v0.42.3
# OpenAPI breaking-change detector (Apache-2.0), for ADR 0011.
OASDIFF=github.com/oasdiff/oasdiff@v1.38.0
# Go vulnerability scanner (BSD-3-Clause), from the Go team.
GOVULNCHECK=golang.org/x/vuln/cmd/govulncheck@v1.9.0

cd "$(dirname "$0")"
ROOT=$(pwd)

say() { printf '==> %s\n' "$*"; }
die() { printf 'run: %s\n' "$*" >&2; exit 1; }

# tool <package>@<version>: print the path of the pinned tool's binary,
# installing it first. Each version gets its own directory under .tools/
# (or $GOLDIE_TOOLS), so a bump never runs a stale binary and CI can cache
# the directory by the hash of this file.
tool() {
	pkg=${1%@*}
	ver=${1##*@}
	dir="${GOLDIE_TOOLS:-$ROOT/.tools}/${pkg##*/}-$ver"
	if [ ! -x "$dir/${pkg##*/}" ]; then
		GOBIN="$dir" go install "$1" >&2 || die "cannot install $1"
	fi
	printf '%s\n' "$dir/${pkg##*/}"
}

golangci() {
	bin=$(tool "$GOLANGCI_LINT")
	"$bin" "$@"
}

cmd_fmt() {
	say "gofmt"
	unformatted=$(gofmt -l cmd internal testdata 2>&1) || die "gofmt failed: $unformatted"
	if [ -n "$unformatted" ]; then
		printf '%s\n' "$unformatted" >&2
		die "files above are not gofmt-formatted (run: gofmt -w <file>)"
	fi
}

cmd_build() {
	say "go build"
	go build ./...
}

cmd_lint() {
	say "golangci-lint"
	golangci run --config "$ROOT/.golangci.yml" ./...
}

# The fixture is a nested module full of deliberate import-rule violations.
# The linter must report every one of them as a depguard issue, and nothing else.
cmd_lint_fixture() {
	say "depguard fixture (violations must be reported)"
	violations=$(grep -rl 'Deliberate violation' testdata/depguard | wc -l | tr -d ' ')
	out=$(cd testdata/depguard && golangci run --config "$ROOT/.golangci.yml" --output.text.colors=false ./... 2>&1) && {
		printf '%s\n' "$out" >&2
		die "depguard fixture passed lint: the import rules do not fire"
	}
	reported=$(printf '%s\n' "$out" | grep -c '(depguard)' || true)
	others=$(printf '%s\n' "$out" | grep -E '\.go:[0-9]+' | grep -vc '(depguard)' || true)
	if [ "$reported" != "$violations" ] || [ "$others" != 0 ]; then
		printf '%s\n' "$out" >&2
		die "fixture expects $violations depguard issues and no others; got $reported depguard, $others other"
	fi
}

# vacuum lints the OpenAPI document. --fail-severity info makes any finding
# (error, warning or info) fail the run, so "zero warnings" holds for the spec.
# An explicit empty --config keeps a ./vacuum.conf.yaml or a user config from
# changing the rules the gate applies, and vacuum runs without any VACUUM_*
# environment variable, which it would otherwise read as flag values.
# --remote=false keeps the check offline: the spec is one self-contained file,
# so no $ref is fetched.
vacuum() {
	cfgdir=$(mktemp -d) || die "cannot create a temporary directory for vacuum"
	: >"$cfgdir/vacuum.conf.yaml"
	bin=$(tool "$VACUUM")
	status=0
	(
		for v in $(env | sed -n 's/^\(VACUUM_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
		exec "$bin" lint --config "$cfgdir/vacuum.conf.yaml" --remote=false \
			--no-update-check --no-banner --no-style --details --fail-severity info "$@"
	) || status=$?
	rm -rf "$cfgdir"
	return "$status"
}

cmd_lint_spec() {
	say "vacuum (OpenAPI spec)"
	vacuum internal/contract/openapi.yaml
}

# The broken fixture must be rejected with lint findings (exit 1 and the
# missing-operationId rule), or the spec linter is not doing its job. Any other
# failure, such as a download or input error, fails this gate too.
cmd_lint_spec_fixture() {
	say "vacuum fixture (broken spec must be rejected)"
	status=0
	out=$(vacuum testdata/openapi/broken.yaml 2>&1) || status=$?
	if [ "$status" = 0 ]; then
		die "broken OpenAPI fixture passed lint: the spec linter does not fire"
	fi
	if [ "$status" != 1 ] || ! printf '%s\n' "$out" | grep -q 'operation-operationId'; then
		printf '%s\n' "$out" >&2
		die "broken OpenAPI fixture failed for the wrong reason (exit $status, expected lint findings)"
	fi
}

# contract-compat <old spec> <new spec>: exit 1 with oasdiff's findings when
# the new spec breaks the old one (ADR 0011: the contract is additive-only).
# scripts/agent-gate calls it to send a breaking change to the maintainer.
cmd_contract_compat() {
	[ $# -eq 2 ] || die "usage: ./run contract-compat <old spec> <new spec>"
	bin=$(tool "$OASDIFF")
	"$bin" breaking "$1" "$2" --fail-on ERR
}

# The breaking fixture removes an endpoint: contract-compat must report it,
# and must accept the spec against itself.
cmd_contract_compat_fixture() {
	say "contract-compat fixture (a removed endpoint must be reported)"
	cmd_contract_compat internal/contract/openapi.yaml internal/contract/openapi.yaml >/dev/null ||
		die "contract-compat rejects the spec against itself"
	status=0
	out=$(cmd_contract_compat internal/contract/openapi.yaml testdata/openapi/breaking.yaml 2>&1) || status=$?
	if [ "$status" != 1 ] || ! printf '%s\n' "$out" | grep -q 'api-path-removed'; then
		printf '%s\n' "$out" >&2
		die "contract-compat did not report the removed endpoint (exit $status)"
	fi
}

cmd_gate() {
	scripts/agent-gate "$@"
}

# Each case in testdata/agent-gate/ has a base/ and a head/ tree and the
# expected output. The case is committed into a throwaway repository and the
# gate must print exactly the expected reasons, with exit 1 when there are any.
cmd_gate_fixture() {
	say "agent-gate fixture (each case gives its expected reasons)"
	for case in testdata/agent-gate/*/; do
		name=$(basename "$case")
		repo=$(mktemp -d) || die "cannot create a temporary directory"
		(
			# The throwaway repository ignores the user's git config (signing,
			# hooks, templates), so the case runs the same everywhere.
			GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
			export GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
			cd "$repo"
			git init -q -b main
			cp -R "$ROOT/${case}base/." .
			git add -A && git -c user.name=fixture -c user.email=fixture@invalid commit -qm base
			git rm -rq . && cp -R "$ROOT/${case}head/." .
			git add -A && git -c user.name=fixture -c user.email=fixture@invalid commit -qm head
		) || { rm -rf "$repo"; die "cannot build the $name case"; }
		status=0
		out=$(cd "$repo" && GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
			"$ROOT/scripts/agent-gate" HEAD~1 HEAD 2>&1) || status=$?
		rm -rf "$repo"
		want=$(cat "${case}expected")
		wstatus=0
		[ -z "$want" ] || wstatus=1
		if [ "$out" != "$want" ] || [ "$status" != "$wstatus" ]; then
			printf 'want (exit %s):\n%s\ngot (exit %s):\n%s\n' "$wstatus" "$want" "$status" "$out" >&2
			die "agent-gate case $name failed"
		fi
	done
}

# Every line of testdata/loop-guard/cases.tsv is "allow" or "deny", a tab and
# a command; the hook must block exactly the "deny" lines.
cmd_guard_fixture() {
	say "loop-guard fixture (the hook blocks exactly the denied commands)"
	command -v jq >/dev/null 2>&1 || die "jq is required for the loop-guard fixture"
	tab=$(printf '\t')
	grep -v '^#' testdata/loop-guard/cases.tsv | while IFS="$tab" read -r want cmd; do
		status=0
		jq -n --arg c "$cmd" '{tool_name: "Bash", tool_input: {command: $c}}' |
			scripts/loop-guard 2>/dev/null || status=$?
		got=allow
		[ "$status" = 2 ] && got=deny
		[ "$got" = "$want" ] || die "loop-guard: want $want, got $got (exit $status): $cmd"
	done
}

# .claude/agents/ holds byte copies of the example agent Items, so the agents
# the loops dispatch are the Items goldie serves (one source of truth).
cmd_sync_agents() {
	mkdir -p .claude/agents
	rm -f .claude/agents/*.md
	cp examples/knowledge/global/agents/*.md .claude/agents/
}

cmd_agents_check() {
	say "agent definitions match their Items"
	out=$(diff -r examples/knowledge/global/agents .claude/agents 2>&1) || {
		printf '%s\n' "$out" >&2
		die ".claude/agents differs from examples/knowledge/global/agents (run: ./run sync-agents)"
	}
}

# red-check [base]: copy the test files the branch changed onto <base> (default
# origin/main) and require the tests to fail there, as proof that they were
# red first. A reviewer tool, not part of check: a test that pins existing
# behaviour passes on <base> by design, and the reviewer judges that case.
cmd_red_check() {
	base=${1:-origin/main}
	mb=$(git merge-base "$base" HEAD) || die "no merge base with $base"
	tests=$(git diff --name-only --no-renames --diff-filter=AM "$mb" HEAD -- '*_test.go')
	if [ -z "$tests" ]; then
		say "red-check: the branch changes no test files"
		return 0
	fi
	wt=$(mktemp -d) || die "cannot create a temporary directory"
	git worktree add -q --detach "$wt" "$mb" || die "cannot create a worktree at $mb"
	for t in $tests; do
		mkdir -p "$wt/$(dirname "$t")"
		git show "HEAD:$t" >"$wt/$t"
	done
	pkgs=$(printf '%s\n' "$tests" | sed 's#/[^/]*$##' | sort -u | sed 's#^#./#')
	status=0
	(cd "$wt" && go test -count=1 $pkgs) >/dev/null 2>&1 || status=$?
	git worktree remove --force "$wt"
	if [ "$status" = 0 ]; then
		die "red-check: the changed tests pass on $base; they don't prove the change"
	fi
	say "red-check: the changed tests fail on $base"
}

cmd_vuln() {
	say "govulncheck"
	bin=$(tool "$GOVULNCHECK")
	"$bin" ./...
}

cmd_test() {
	say "go test"
	go test -count=1 "$@" ./...
}

cmd_regen() {
	say "regen: nothing to generate yet"
	# Generators (OpenAPI types and server, TypeScript types, component docs)
	# register here as their issues land. `check` then verifies no drift.
}

cmd_versions() {
	printf 'go (module requires): %s\n' "$(awk '$1 == "go" {print $2}' go.mod)"
	printf 'go (installed):       %s\n' "$(go version)"
	for t in "$GOLANGCI_LINT" "$VACUUM" "$OASDIFF" "$GOVULNCHECK"; do
		printf 'pinned: %s\n' "$t"
	done
}

# CI runs the four groups as parallel jobs; `check` runs them in sequence.
# scripts/agent-gate reads these bodies: removing a step needs the maintainer.
cmd_check_lint() {
	cmd_fmt
	cmd_build
	cmd_lint
	cmd_lint_fixture
}

cmd_check_spec() {
	cmd_lint_spec
	cmd_lint_spec_fixture
	cmd_contract_compat_fixture
}

cmd_check_harness() {
	cmd_gate_fixture
	cmd_guard_fixture
	cmd_agents_check
}

cmd_check_test() {
	cmd_test -race
}

cmd_check() {
	cmd_check_lint
	cmd_check_spec
	cmd_check_harness
	cmd_check_test
	say "check passed"
}

usage() {
	awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

[ $# -ge 1 ] || { usage; exit 2; }
sub=$1
shift
case "$sub" in
check) cmd_check ;;
check-lint) cmd_check_lint ;;
check-spec) cmd_check_spec ;;
check-harness) cmd_check_harness ;;
check-test) cmd_check_test ;;
test) cmd_test "$@" ;;
lint) cmd_lint ;;
lint-spec) cmd_lint_spec ;;
lint-spec-fixture) cmd_lint_spec_fixture ;;
contract-compat) cmd_contract_compat "$@" ;;
gate) cmd_gate "$@" ;;
red-check) cmd_red_check "$@" ;;
vuln) cmd_vuln ;;
sync-agents) cmd_sync_agents ;;
regen) cmd_regen ;;
versions) cmd_versions ;;
help | -h | --help) usage ;;
*) usage >&2; exit 2 ;;
esac
