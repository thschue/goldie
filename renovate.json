{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency updates for goldie (ADR 0018). Green updates merge themselves through platform auto-merge after the required checks and the release-age wait; the delivery loop fixes red or conflicted ones.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests",
    ":semanticPrefixFixDepsChoreOthers"
  ],
  "semanticCommits": "enabled",
  "enabledManagers": ["gomod", "github-actions", "custom.regex", "dockerfile", "docker-compose"],
  "automerge": true,
  "platformAutomerge": true,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 3,
  "schedule": ["before 6am on monday"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "description": "Pinned tools in ./run, marked with a '# renovate: datasource=<ds> depName=<module>' comment on the line above",
      "customType": "regex",
      "managerFilePatterns": ["/^run$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n[A-Z_]+=[^@\\s]+@(?<currentValue>v[^\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Fixture modules under testdata are data, not dependencies",
      "matchFileNames": ["testdata/**"],
      "enabled": false
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "go modules"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "pinned tools"
    },
    {
      "description": "The base images of the Dockerfile and compose.yaml (#740), pinned by digest",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "container images",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"]
    },
    {
      "description": "The Go and Node image versions follow go.mod and web/.nvmrc, which move by a deliberate PR; their digests still update",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["node", "golang"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "The Go directive and toolchain move only by a deliberate PR",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "enabled": false
    }
  ]
}
